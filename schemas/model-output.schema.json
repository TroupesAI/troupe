{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.example/schema/0.11/model-output.schema.json",
  "title": "Troupe model output",
  "description": "What a model returns (Play 3.4): a structured reply, or a tracker's result without parts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "speaker": {
            "$ref": "bundle.schema.json#/$defs/id"
          },
          "text": {
            "type": "string"
          },
          "knownBy": {
            "$ref": "bundle.schema.json#/$defs/ids"
          }
        }
      }
    },
    "changes": {
      "$ref": "bundle.schema.json#/$defs/stateValues"
    },
    "reason": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "bundle.schema.json#/$defs/entry"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "bundle.schema.json#/$defs/character"
      }
    }
  }
}
