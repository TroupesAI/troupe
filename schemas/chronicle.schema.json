{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.example/schema/0.11/chronicle.schema.json",
  "title": "Troupe chronicle",
  "description": "A Troupe chronicle: one character's definition, memories and carried values.",
  "type": "object",
  "required": [
    "troupe",
    "kind",
    "id",
    "character"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "troupe": {
      "$ref": "bundle.schema.json#/$defs/version"
    },
    "kind": {
      "const": "chronicle"
    },
    "id": {
      "$ref": "bundle.schema.json#/$defs/opaqueId"
    },
    "character": {
      "$ref": "bundle.schema.json#/$defs/character"
    },
    "persona": {
      "$ref": "bundle.schema.json#/$defs/character"
    },
    "bundle": {
      "$ref": "bundle.schema.json#/$defs/opaqueId"
    },
    "limits": {
      "$ref": "bundle.schema.json#/$defs/limits"
    },
    "memories": {
      "type": "array",
      "items": {
        "$ref": "bundle.schema.json#/$defs/entry"
      }
    },
    "values": {
      "$ref": "bundle.schema.json#/$defs/stateValues"
    },
    "ext": {
      "$ref": "bundle.schema.json#/$defs/ext"
    }
  }
}
