---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { spec } from "../sources.ts";

const { id } = Astro.locals.starlightRoute.entry;
---

<Default />
<div>
  {id === "format" && <p>Version {spec.version} ({spec.status}) · {spec.date}</p>}
  <button data-markdown={`/${id}.md`}>Copy Markdown</button>
</div>

<script>
  // The fetch goes inside the clipboard item, so Safari still counts the write as part of the click.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-markdown]")) {
    button.addEventListener("click", async () => {
      const text = fetch(button.dataset.markdown!)
        .then((r) => r.text())
        .then((t) => new Blob([t], { type: "text/plain" }));
      await navigator.clipboard.write([new ClipboardItem({ "text/plain": text })]);
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy Markdown"), 2000);
    });
  }
</script>

<style>
  div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1rem;
    color: var(--sl-color-gray-3);
  }
  p {
    margin: 0;
  }
  button {
    margin-inline-start: auto;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  button:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
</style>
