---
import Default from "@astrojs/starlight/components/PageTitle.astro";
---

<Default />
<button data-markdown={`/${Astro.locals.starlightRoute.entry.id}.md`}>Copy Markdown</button>

<script>
  // The fetch goes inside the clipboard item, so Safari still counts the write as part of the click.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-markdown]")) {
    button.addEventListener("click", async () => {
      const text = fetch(button.dataset.markdown!)
        .then((r) => r.text())
        .then((t) => new Blob([t], { type: "text/plain" }));
      await navigator.clipboard.write([new ClipboardItem({ "text/plain": text })]);
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy Markdown"), 2000);
    });
  }
</script>

<style>
  button {
    margin-top: 1rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  button:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
</style>
