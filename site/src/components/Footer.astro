---
import Default from "@astrojs/starlight/components/Footer.astro";
import { repo } from "../sources.ts";
---

<Default />
<p>
  The spec and guides are licensed under <a href={`${repo}/blob/main/spec/LICENSE`}>CC BY 4.0</a>, everything else
  under <a href={`${repo}/blob/main/LICENSE`}>Apache-2.0</a>. The TroupesAI logo is covered by neither.
</p>

<style>
  p {
    margin-top: 3rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
  a {
    color: var(--sl-color-text-accent);
  }
</style>
