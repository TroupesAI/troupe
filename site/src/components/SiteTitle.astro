---
import { Image } from "astro:assets";
import logo from "../assets/logo-transparent.webp";
import { spec } from "../sources.ts";

// Starlight's own site title would load the full-size logo for a 1.75rem image.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const { version, status } = spec();
---

<a href={siteTitleHref}>
  <Image src={logo} alt="" width={28} densities={[1, 2]} loading="eager" />
  <span translate="no">{siteTitle}</span>
  <small>{version} {status}</small>
</a>

<style>
  a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--sl-color-white);
    font-family: var(--font-serif);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  /* The version is a quiet badge, so it reads as a label rather than part of the name. */
  small {
    padding: 0.0625rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-pill);
    color: var(--sl-color-gray-3);
    font-family: var(--font-sans);
    font-size: var(--sl-text-2xs);
    font-weight: 500;
  }
</style>
