{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Troupe conformance case",
  "description": "The shape of a case file (conformance/README.md). Checked by bun run check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "tests"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "bundle": {
      "type": "object"
    },
    "bundleFile": {
      "type": "string"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "messages"
      ],
      "properties": {
        "header": {
          "type": "object"
        },
        "messages": {
          "type": "array"
        }
      }
    },
    "sessionFile": {
      "type": "string"
    },
    "addMessages": {
      "type": "array"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "state",
              "ended",
              "macro",
              "cel",
              "check",
              "parse",
              "chronicle"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "state"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "expect"
              ],
              "properties": {
                "type": {
                  "const": "state"
                },
                "name": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "expect": {
                  "type": "object"
                },
                "at": {
                  "type": "string",
                  "minLength": 1
                },
                "absent": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ended"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "expect",
                "at"
              ],
              "properties": {
                "type": {
                  "const": "ended"
                },
                "name": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "expect": {
                  "type": "boolean"
                },
                "at": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "macro"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "expect",
                "text"
              ],
              "properties": {
                "type": {
                  "const": "macro"
                },
                "name": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "expect": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "minLength": 1
                },
                "char": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "narrator": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "cel"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "expect",
                "expr"
              ],
              "properties": {
                "type": {
                  "const": "cel"
                },
                "name": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "expect": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "checkError"
                      ],
                      "properties": {
                        "checkError": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                },
                "expr": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "entry",
                    "event"
                  ]
                },
                "at": {
                  "type": "string",
                  "minLength": 1
                },
                "char": {
                  "type": "string"
                },
                "self": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "check"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "expect"
              ],
              "properties": {
                "type": {
                  "const": "check"
                },
                "name": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "expect": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "codes"
                  ],
                  "properties": {
                    "codes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "includes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "code",
                          "at"
                        ],
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "at": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "parse"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "expect",
                "kind"
              ],
              "properties": {
                "type": {
                  "const": "parse"
                },
                "name": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "expect": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "codes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "codes"
                  ]
                },
                "kind": {
                  "enum": [
                    "bundle",
                    "session",
                    "chronicle",
                    "package"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "base64": {
                  "type": "string"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "base64"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "chronicle"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "expect"
              ],
              "properties": {
                "type": {
                  "const": "chronicle"
                },
                "name": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "expect": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "codes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "codes"
                  ]
                },
                "chronicle": {
                  "type": "object"
                },
                "chronicleFile": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "bundle",
          "bundleFile"
        ]
      },
      {
        "required": [
          "session",
          "sessionFile"
        ]
      }
    ]
  }
}
