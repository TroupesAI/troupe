{
  "description": "Format Appendix B: every checkable claim about The Lantern Heist and its session",
  "bundleFile": "../../../examples/lantern-heist.troupe.json",
  "sessionFile": "../../../examples/lantern-heist.troupe-session.jsonl",
  "tests": [
    {
      "type": "check",
      "name": "B.2 and B.3 are valid",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "state",
      "name": "before the root: initial values, the whole cast present",
      "expect": {
        "bell": 6,
        "trust.kai": 0.4,
        "trust.elena": 0.7,
        "scene.location": "",
        "scene.present": [
          "mara",
          "elena",
          "kai"
        ]
      }
    },
    {
      "type": "state",
      "name": "the root records the opening's values and the answer",
      "at": "1",
      "expect": {
        "scene.location": "rooftops",
        "scene.present": [
          "mara",
          "elena",
          "kai"
        ],
        "approach": "quiet",
        "bell": 6
      }
    },
    {
      "type": "state",
      "name": "branch 3: Kai has left",
      "at": "3",
      "expect": {
        "scene.present": [
          "mara",
          "elena"
        ],
        "bell": 6,
        "trust.kai": 0.4
      }
    },
    {
      "type": "state",
      "name": "branch 4: the seventh bell, more trust",
      "at": "4",
      "expect": {
        "scene.present": [
          "mara",
          "elena",
          "kai"
        ],
        "bell": 7,
        "trust.kai": 0.5
      }
    },
    {
      "type": "macro",
      "name": "the visible clock",
      "at": "4",
      "text": "The last bell to ring was the {{state.bell}}th. The plan: {{state.approach}}.",
      "expect": "The last bell to ring was the 7th. The plan: Slip in unseen."
    },
    {
      "type": "state",
      "name": "message 3 records Kai's own nerve",
      "at": "3",
      "expect": {
        "kai.nerve": 1
      }
    }
  ]
}
