{
  "description": "The authoring guide's whereabouts pattern: a scenario variable of cast records where each character waits, and the event that brings whoever waits at the new location into the scene type-checks; a map's filter yields its keys",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "ann",
        "name": "Ann",
        "description": "A guide."
      },
      {
        "id": "ghost",
        "name": "The Ghost",
        "description": "A ghost in the cellar."
      }
    ],
    "worlds": [
      {
        "id": "w",
        "name": "W",
        "locations": [
          {
            "id": "street",
            "name": "Street"
          },
          {
            "id": "hall",
            "name": "Hall"
          },
          {
            "id": "cellar",
            "name": "Cellar"
          }
        ]
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "ann"
          },
          {
            "character": "ghost",
            "spoiler": true
          }
        ],
        "variables": [
          {
            "id": "where",
            "type": "string",
            "of": "cast",
            "initial": {
              "*": "",
              "ghost": "cellar"
            },
            "by": [
              "model"
            ],
            "description": "Where each character stays when not with {{user}}; empty for those who go along."
          }
        ],
        "events": [
          {
            "id": "arrive",
            "when": "ago('scene.location') == 0 && scene.location != ''",
            "compute": {
              "scene.present": "scene.present.filter(c, state.where[c] == '') + state.where.filter(c, state.where[c] == scene.location)"
            }
          }
        ],
        "openings": [
          {
            "id": "o",
            "set": {
              "scene.location": "street"
            },
            "content": [
              {
                "speaker": "ann",
                "text": "This way."
              }
            ]
          },
          {
            "id": "street_start",
            "title": "On the street",
            "set": {
              "scene.location": "street"
            }
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ],
      "head": "6"
    },
    "messages": [
      {
        "id": "1",
        "opening": "o",
        "from": "system",
        "content": [
          {
            "speaker": "ann",
            "text": "This way."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.location": "street",
              "scene.present": [
                "p",
                "ann"
              ]
            }
          },
          {
            "by": "rules",
            "event": "arrive",
            "set": {
              "scene.present": [
                "p",
                "ann"
              ]
            }
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Let's check the cellar."
          }
        ],
        "changes": [
          {
            "by": "model",
            "set": {
              "scene.location": "cellar"
            }
          },
          {
            "by": "rules",
            "event": "arrive",
            "set": {
              "scene.present": [
                "p",
                "ann",
                "ghost"
              ]
            }
          }
        ]
      },
      {
        "id": "3",
        "parent": "2",
        "from": "model",
        "char": "ann",
        "content": [
          {
            "speaker": "ann",
            "text": "I'll wait down here."
          }
        ],
        "changes": [
          {
            "by": "model",
            "set": {
              "where.ann": "cellar"
            }
          }
        ]
      },
      {
        "id": "4",
        "parent": "3",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Back up to the hall."
          }
        ],
        "changes": [
          {
            "by": "model",
            "set": {
              "scene.location": "hall"
            }
          },
          {
            "by": "rules",
            "event": "arrive",
            "set": {
              "scene.present": [
                "p"
              ]
            }
          }
        ]
      },
      {
        "id": "5",
        "parent": "4",
        "from": "model",
        "content": [
          {
            "text": "The hall is empty."
          }
        ]
      },
      {
        "id": "6",
        "parent": "5",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Down again."
          }
        ],
        "changes": [
          {
            "by": "model",
            "set": {
              "scene.location": "cellar"
            }
          },
          {
            "by": "rules",
            "event": "arrive",
            "set": {
              "scene.present": [
                "p",
                "ann",
                "ghost"
              ]
            }
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "name": "the variable and the event type-check",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "state",
      "name": "the initial whereabouts",
      "expect": {
        "where.p": "",
        "where.ann": "",
        "where.ghost": "cellar"
      }
    },
    {
      "type": "cel",
      "name": "a map's filter yields its keys, so the sum is a list of character IDs",
      "expr": "state.where.filter(c, state.where[c] == 'cellar') == ['ghost'] && scene.present.filter(c, state.where[c] == '') + ['ghost'] == ['p', 'ann', 'ghost']",
      "expect": true
    }
  ]
}
