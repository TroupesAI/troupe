{
  "description": "Pulling (Format 7.2; Play 5.6): entries with pull and a title form a catalog of visible entries not selected whose when holds; once, cooldown and chance don't limit pulling; pulled entries are recorded; pull entries without keys are not always-on",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      },
      {
        "id": "b",
        "name": "Bea",
        "description": "Bea."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          },
          {
            "character": "b"
          }
        ]
      }
    ],
    "worlds": [
      {
        "id": "w",
        "name": "W",
        "entries": [
          {
            "id": "dragons",
            "title": "Dragons of the North",
            "pull": true,
            "text": "Northern dragons hoard silver."
          },
          {
            "id": "elves",
            "title": "Elves",
            "pull": true,
            "keys": [
              "elf"
            ],
            "text": "Elves never lie."
          },
          {
            "id": "secret",
            "title": "Hidden",
            "pull": true,
            "knownBy": [
              "b"
            ],
            "text": "Bea's secret."
          },
          {
            "id": "later",
            "title": "Later",
            "pull": true,
            "when": "turn > 5",
            "text": "Not yet."
          },
          {
            "id": "always",
            "text": "Always on."
          },
          {
            "id": "tome",
            "title": "The tome",
            "pull": true,
            "once": true,
            "cooldown": 3,
            "chance": 0,
            "text": "The tome names the dragon."
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Tell me about the land."
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "model",
        "char": "a",
        "activated": [
          "w/dragons",
          "w/always",
          "w/tome"
        ],
        "content": [
          {
            "speaker": "a",
            "text": "Silver..."
          }
        ]
      },
      {
        "id": "3",
        "parent": "2",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "An elf!"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "select",
      "name": "the catalog; a pull entry without keys doesn't activate on its own",
      "for": "a",
      "parent": "1",
      "messageId": "2x",
      "expect": {
        "activated": [
          "w/always"
        ],
        "catalog": [
          "w/dragons",
          "w/elves",
          "w/tome"
        ]
      }
    },
    {
      "type": "select",
      "name": "a pulled entry is recorded with the others",
      "for": "a",
      "parent": "1",
      "messageId": "2x",
      "pulled": [
        "w/dragons"
      ],
      "expect": {
        "activated": [
          "w/dragons",
          "w/always"
        ],
        "catalog": [
          "w/dragons",
          "w/elves",
          "w/tome"
        ]
      }
    },
    {
      "type": "select",
      "name": "keys still activate a pull entry; selected entries leave the catalog",
      "for": "a",
      "parent": "3",
      "messageId": "4x",
      "expect": {
        "activated": [
          "w/elves",
          "w/always"
        ],
        "catalog": [
          "w/dragons",
          "w/tome"
        ]
      }
    },
    {
      "type": "select",
      "name": "Bea's catalog includes what she knows",
      "for": "b",
      "parent": "1",
      "messageId": "2y",
      "expect": {
        "catalog": [
          "w/dragons",
          "w/elves",
          "w/secret",
          "w/tome"
        ]
      }
    },
    {
      "type": "select",
      "name": "once, cooldown and chance don't limit pulling",
      "note": "w/tome is once, was recorded on message 2 (d = 1, inside its cooldown of 3), and has chance 0; it is still eligible and can be pulled.",
      "for": "a",
      "parent": "3",
      "messageId": "4x",
      "pulled": [
        "w/tome"
      ],
      "expect": {
        "activated": [
          "w/elves",
          "w/always",
          "w/tome"
        ],
        "catalog": [
          "w/dragons",
          "w/tome"
        ]
      }
    },
    {
      "type": "cel",
      "name": "pulled entries count as activations",
      "at": "3",
      "expr": "count('w/dragons') == 1 && ago('w/dragons') == 1",
      "expect": true
    }
  ]
}
