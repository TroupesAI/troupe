{
  "description": "Absent values (Format 2.2): knownBy: [] reads as [\"narrator\"], so an emptied list never reveals a secret",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          }
        ],
        "entries": [
          {
            "id": "secret",
            "knownBy": [],
            "text": "The vault is empty."
          },
          {
            "id": "open",
            "text": "It is raining."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "select",
      "name": "Ann doesn't see it",
      "for": "a",
      "messageId": "1",
      "expect": {
        "activated": [
          "s/open"
        ]
      }
    },
    {
      "type": "select",
      "name": "the narrator does",
      "messageId": "1",
      "expect": {
        "activated": [
          "s/secret",
          "s/open"
        ]
      }
    }
  ]
}
