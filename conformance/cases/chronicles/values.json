{
  "description": "A chronicle's values name carried, non-derived variables of its character: a value key that names a variable without carry, or a derived one, is UNKNOWN_VARIABLE (Format 13, 17.2)",
  "tests": [
    {
      "type": "chronicle",
      "chronicle": {
        "kind": "chronicle",
        "id": "c-kai",
        "character": {
          "id": "kai",
          "name": "Kai",
          "description": "A drifter.",
          "variables": [
            {
              "id": "feelings",
              "type": "int",
              "of": "cast",
              "min": -10,
              "max": 10,
              "carry": true,
              "description": "d"
            },
            {
              "id": "mood",
              "type": "string",
              "description": "not carried"
            },
            {
              "id": "level",
              "type": "int",
              "carry": true,
              "derive": "1",
              "description": "derived, never carried"
            }
          ]
        },
        "persona": {
          "id": "mara",
          "name": "Mara",
          "description": "d"
        },
        "limits": {
          "lines": [
            "gore"
          ],
          "veils": [
            "romance"
          ]
        },
        "memories": [
          {
            "id": "met",
            "carry": true,
            "text": "Kai met Mara at the docks."
          }
        ],
        "values": {
          "feelings.mara": 7,
          "mood": "glum",
          "level": 3
        }
      },
      "expect": {
        "codes": [
          "UNKNOWN_VARIABLE"
        ]
      }
    }
  ]
}
