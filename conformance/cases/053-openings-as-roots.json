{
  "description": "Openings are roots (Format 6.3, 12; Play 2.1): each opening tried is a root; swiping adds another; opening, turn and state belong to the path's root",
  "bundleFile": "../../examples/lantern-heist.troupe.json",
  "sessionFile": "../../examples/lantern-heist.troupe-session.jsonl",
  "addMessages": [
    {
      "id": "c1",
      "opening": "caught",
      "from": "system",
      "content": [
        {
          "text": "Water laps at your knees. The vault door has slammed shut behind you, and Kai is nowhere to be seen."
        },
        {
          "speaker": "elena",
          "text": "He was supposed to hold that door. *She doesn't look surprised.*"
        }
      ],
      "changes": [
        {
          "by": "rules",
          "set": {
            "scene.location": "vault",
            "bell": 11,
            "scene.present": [
              "mara",
              "elena"
            ]
          }
        },
        {
          "by": "player",
          "set": {
            "approach": "loud"
          }
        }
      ]
    },
    {
      "id": "c2",
      "parent": "c1",
      "from": "player",
      "content": [
        {
          "speaker": "mara",
          "text": "Where is he?"
        }
      ]
    }
  ],
  "tests": [
    {
      "type": "state",
      "name": "the second root starts in the vault at the eleventh bell, without Kai",
      "at": "c1",
      "expect": {
        "scene.location": "vault",
        "bell": 11,
        "scene.present": [
          "mara",
          "elena"
        ],
        "approach": "loud"
      }
    },
    {
      "type": "state",
      "name": "the first root is untouched",
      "at": "4",
      "expect": {
        "scene.location": "rooftops",
        "bell": 7
      }
    },
    {
      "type": "cel",
      "at": "c2",
      "expr": "opening == 'caught' && turn == 1 && ago('bell') == 1",
      "expect": true
    },
    {
      "type": "cel",
      "at": "2",
      "expr": "opening == 'rooftop_briefing'",
      "expect": true
    },
    {
      "type": "select",
      "name": "Elena in the vault: bell 11 turns on heist/late (c3: rain)",
      "for": "elena",
      "parent": "c2",
      "messageId": "c3",
      "expect": {
        "activated": [
          "veyra/weather_rain",
          "elena/master_key",
          "heist/style",
          "heist/clock",
          "heist/late"
        ]
      }
    },
    {
      "type": "select",
      "name": "generating for absent Kai: his entries are candidates (n2: fog)",
      "for": "kai",
      "parent": "c2",
      "messageId": "n2",
      "expect": {
        "activated": [
          "veyra/weather_fog",
          "kai/voice",
          "kai/deal",
          "heist/style",
          "heist/clock",
          "heist/late"
        ]
      }
    },
    {
      "type": "events",
      "at": "c1",
      "expect": {
        "changes": []
      }
    },
    {
      "type": "swipe",
      "name": "swiping to 'Already caught' again creates a root",
      "opening": "caught",
      "answers": {
        "approach": "loud"
      },
      "rootId": "c9",
      "expect": {
        "root": {
          "id": "c9",
          "opening": "caught",
          "from": "system",
          "content": [
            {
              "text": "Water laps at your knees. The vault door has slammed shut behind you, and Kai is nowhere to be seen."
            },
            {
              "speaker": "elena",
              "text": "He was supposed to hold that door. *She doesn't look surprised.*"
            }
          ],
          "changes": [
            {
              "by": "rules",
              "set": {
                "scene.location": "vault",
                "bell": 11,
                "scene.present": [
                  "mara",
                  "elena"
                ]
              }
            },
            {
              "by": "player",
              "set": {
                "approach": "loud"
              }
            }
          ]
        },
        "head": "c9"
      }
    },
    {
      "type": "check",
      "expect": {
        "codes": []
      }
    }
  ]
}
