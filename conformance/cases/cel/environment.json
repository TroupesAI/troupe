{
  "description": "The CEL environment (Format 10.1) at Format Appendix B's messages: turn, opening, scenario, players, char, self, own, user, scene.within, hour and weekday at a timestamp's offset, keyed variables read with brackets, equality within one type, runtime errors, and only the functions Format 10.2 lists",
  "note": "State at 4: bell 7 and trust.kai 50 from its change; scene.location rooftops from the root. At 3, Kai has left and his nerve is 1. Message 2 is at 21:04 on Saturday 17 October 2026, at +02:00.",
  "bundleFile": "../../../examples/lantern-heist/bundle.json",
  "sessionFile": "../../../examples/lantern-heist/sessions/heist.troupe-session.jsonl",
  "tests": [
    {
      "type": "cel",
      "name": "turn counts rounds: player messages on the path",
      "at": "4",
      "expr": "turn == 1",
      "expect": true
    },
    {
      "type": "cel",
      "name": "an opening root is round 0",
      "at": "1",
      "expr": "turn == 0",
      "expect": true
    },
    {
      "type": "cel",
      "name": "opening is the path root's opening",
      "at": "4",
      "expr": "opening == 'rooftop_briefing'",
      "expect": true
    },
    {
      "type": "cel",
      "at": "4",
      "expr": "scenario == 'heist' && self == 'heist'",
      "expect": true
    },
    {
      "type": "cel",
      "at": "4",
      "expr": "players == ['mara'] && user == 'mara'",
      "expect": true
    },
    {
      "type": "cel",
      "name": "char is \"\" for the narrator",
      "at": "4",
      "expr": "char == ''",
      "expect": true
    },
    {
      "type": "cel",
      "name": "self is the expression's owner, and own its variables",
      "at": "3",
      "self": "kai",
      "expr": "self == 'kai' && own.nerve == 1 && state.kai.nerve == 1",
      "expect": true
    },
    {
      "type": "cel",
      "name": "branch 4 has no nerve change",
      "at": "4",
      "self": "kai",
      "expr": "own.nerve == 0",
      "expect": true
    },
    {
      "type": "cel",
      "name": "a scenario's own is its state",
      "at": "4",
      "expr": "own.bell == state.bell",
      "expect": true
    },
    {
      "type": "cel",
      "name": "scene.within: the location, then its ancestors",
      "at": "4",
      "expr": "scene.within == ['rooftops', 'manor'] && 'manor' in scene.within",
      "expect": true
    },
    {
      "type": "cel",
      "name": "before the root: no location",
      "expr": "scene.location == ''",
      "expect": true
    },
    {
      "type": "cel",
      "at": "3",
      "expr": "!('kai' in scene.present) && scene.present == ['mara', 'elena']",
      "expect": true
    },
    {
      "type": "cel",
      "name": "a computed key is read with brackets",
      "at": "4",
      "char": "kai",
      "expr": "state.trust[char] == 50 && state.trust.elena == 70 && state.trust.mara == 50",
      "expect": true
    },
    {
      "type": "cel",
      "name": "selecting char from a keyed variable is a CEL_ERROR (Format 10.2)",
      "at": "4",
      "char": "kai",
      "expr": "state.trust.char == 50",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "cel",
      "expr": "state.trust.user == 50",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "cel",
      "at": "4",
      "expr": "state.bell == 7 && state.bell != 8 && state.trust.kai >= 50 && state.bell > 6",
      "expect": true
    },
    {
      "type": "cel",
      "name": "the confess entry's condition",
      "at": "4",
      "expr": "state.trust.kai >= 80",
      "expect": false
    },
    {
      "type": "cel",
      "name": "a double literal is a CEL_ERROR",
      "at": "4",
      "expr": "state.bell == 7.0",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "cel",
      "at": "2",
      "expr": "state.approach == 'quiet' && !state.key_revealed",
      "expect": true
    },
    {
      "type": "cel",
      "name": "hour and weekday are local to the timestamp's offset",
      "at": "2",
      "expr": "hour == 21 && weekday == 6",
      "expect": true
    },
    {
      "type": "cel",
      "name": "elapsed is 0 when the parent has no at",
      "at": "2",
      "expr": "elapsed == 0",
      "expect": true
    },
    {
      "type": "cel",
      "name": "a message without at",
      "at": "4",
      "expr": "hour == -1 && weekday == -1",
      "expect": true
    },
    {
      "type": "cel",
      "name": "|| absorbs a runtime error",
      "at": "4",
      "expr": "{'a': 1}['b'] == 1 || true",
      "expect": true
    },
    {
      "type": "cel",
      "name": "a runtime error makes a condition false",
      "at": "4",
      "expr": "{'a': 1}['b'] == 1",
      "expect": false
    },
    {
      "type": "cel",
      "at": "4",
      "expr": "state.trust.kai - 1 > 0",
      "expect": true
    },
    {
      "type": "cel",
      "name": "conditions must be bool",
      "expr": "state.bell + 1",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "cel",
      "name": "hit() is available in every expression",
      "expr": "hit('x')",
      "expect": {
        "checkError": false
      }
    },
    {
      "type": "cel",
      "name": "undeclared variables fail the type check",
      "expr": "state.nope",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "cel",
      "expr": "'ab'.contains('a') && 'lantern'.startsWith('lan')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "only the listed functions: no strings extension",
      "expr": "'abc'.indexOf('b') == 1",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "cel",
      "name": "no matches()",
      "expr": "'Kai'.matches('^K')",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "cel",
      "name": "no count()",
      "expr": "count('veyra/guards') > 0",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "cel",
      "name": "no comprehensions",
      "expr": "[1, 2].exists(x, x > 1)",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "check",
      "name": "B.2 and B.3 conform",
      "expect": {
        "codes": []
      }
    }
  ]
}
