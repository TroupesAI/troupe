{
  "description": "CEL (Format 11.1): hour and weekday in the session's timezone (−1 if unknown), elapsed in whole seconds, user, min, max, abs",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      },
      {
        "id": "b",
        "name": "Bea",
        "description": "Bea."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {},
          {
            "character": "a"
          },
          {
            "character": "b"
          }
        ],
        "variables": [
          {
            "id": "hp",
            "type": "int",
            "initial": -7,
            "description": "d"
          },
          {
            "id": "x",
            "type": "number",
            "initial": 2.5,
            "description": "d"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        },
        {
          "id": "q",
          "name": "Quin",
          "description": "Quin."
        }
      ],
      "players": [
        "p",
        "q"
      ],
      "timezone": "Asia/Tokyo"
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "at": "2026-10-09T14:30:00Z",
        "content": [
          {
            "speaker": "p",
            "text": "x"
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "player",
        "at": "2026-10-09T14:31:30.900Z",
        "content": [
          {
            "speaker": "q",
            "text": "y"
          }
        ]
      },
      {
        "id": "3",
        "parent": "2",
        "from": "model",
        "char": "a",
        "content": [
          {
            "text": "z"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "cel",
      "name": "14:30 UTC is 23:30 Friday in Tokyo",
      "at": "1",
      "expr": "hour == 23 && weekday == 5",
      "expect": true
    },
    {
      "type": "cel",
      "name": "elapsed: whole seconds",
      "at": "2",
      "expr": "elapsed == 90",
      "expect": true
    },
    {
      "type": "cel",
      "name": "no at: hour and weekday are −1, elapsed 0",
      "at": "3",
      "expr": "hour == -1 && weekday == -1 && elapsed == 0",
      "expect": true
    },
    {
      "type": "cel",
      "name": "user: the latest player message's speaker",
      "at": "3",
      "expr": "user == 'q'",
      "expect": true
    },
    {
      "type": "cel",
      "at": "1",
      "expr": "user == 'p'",
      "expect": true
    },
    {
      "type": "cel",
      "expr": "abs(state.hp) == 7 && min(state.hp, 3) == -7 && max(state.x, 1.0) == 2.5 && abs(-2.5) == 2.5",
      "expect": true
    },
    {
      "type": "cel",
      "name": "min and max take numbers of one type",
      "expr": "min(state.hp, 2.0) < 0",
      "expect": {
        "checkError": true
      }
    },
    {
      "type": "cel",
      "name": "state isn't indexed by computed strings",
      "expr": "state['hp'] == 1",
      "expect": {
        "checkError": true
      }
    }
  ]
}
