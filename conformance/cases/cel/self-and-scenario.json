{
  "description": "self, char and scenario (Format 11.1): self is the expression's owner and char the character a message is written for, so char == self holds on the owner's own turns; scenario is the session's scenario",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      },
      {
        "id": "b",
        "name": "Bea",
        "description": "Bea."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          },
          {
            "character": "b"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "text": "Hi."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "cel",
      "name": "the scenario's own expression",
      "expr": "scenario == 's' && self == 's'",
      "expect": true
    },
    {
      "type": "cel",
      "name": "Ann's entry on her own turn",
      "kind": "entry",
      "self": "a",
      "char": "a",
      "at": "1",
      "expr": "char == self && self == 'a' && scenario == 's'",
      "expect": true
    },
    {
      "type": "cel",
      "name": "Ann's entry on Bea's turn",
      "kind": "entry",
      "self": "a",
      "char": "b",
      "at": "1",
      "expr": "char == self",
      "expect": false
    },
    {
      "type": "check",
      "expect": {
        "codes": []
      }
    }
  ]
}
