{
  "description": "Presence at the start (Play 2.1): the players and the opening's speakers, or the opening's scene.present plus the players; non-cast speakers are ignored",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      },
      {
        "id": "b",
        "name": "Bea",
        "description": "Bea."
      },
      {
        "id": "c",
        "name": "Cy",
        "description": "Cy."
      },
      {
        "id": "z",
        "name": "Zed",
        "description": "Not in the cast."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          },
          {
            "character": "b"
          },
          {
            "character": "c"
          }
        ],
        "openings": [
          {
            "id": "talk",
            "content": [
              {
                "text": "A room."
              },
              {
                "speaker": "c",
                "text": "Hi."
              },
              {
                "speaker": "z",
                "text": "I'm not in the cast."
              },
              {
                "speaker": "a",
                "text": "Hello."
              }
            ]
          },
          {
            "id": "listed",
            "set": {
              "scene.present": [
                "b"
              ]
            },
            "content": [
              {
                "speaker": "a",
                "text": "Ann speaks, but set lists only Bea."
              }
            ]
          },
          {
            "id": "empty",
            "content": [
              {
                "text": "Nobody speaks."
              }
            ]
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "start",
      "scenario": "s",
      "opening": "talk",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "expect": {
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.present": [
                "p",
                "a",
                "c"
              ]
            }
          }
        ]
      }
    },
    {
      "type": "start",
      "scenario": "s",
      "opening": "listed",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "expect": {
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.present": [
                "p",
                "b"
              ]
            }
          }
        ]
      }
    },
    {
      "type": "start",
      "scenario": "s",
      "opening": "empty",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "expect": {
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.present": [
                "p"
              ]
            }
          }
        ]
      }
    },
    {
      "type": "start",
      "name": "without an opening, the player's first message is the root and the whole cast is present",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "firstMessage": {
        "from": "player",
        "content": [
          {
            "text": "Hi."
          }
        ]
      },
      "expect": {
        "changes": [],
        "state": {
          "scene.present": [
            "p",
            "a",
            "b",
            "c"
          ]
        }
      }
    }
  ]
}
