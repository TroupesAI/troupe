            "name": "Dock"
          }
        ]
      },
      {
        "id": "w2",
        "name": "Elsewhere",
        "locations": [
          {
            "id": "moon",
            "name": "Moon"
          }
        ]
      }
    ],
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      },
      {
