            "speaker": "p",
            "text": "a"
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "player",
        "content": [
          {
            "speaker": "b",
            "text": "To the moon."
          }
        ],
        "changes": [
          {
            "by": "player",
            "set": {
              "scene.location": "moon"
            }
          }
        ]
      }
