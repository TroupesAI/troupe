          "name": "Pat",
          "description": "Pat."
        },
        {
          "id": "kai",
          "name": "Kai Mercer",
          "description": "An edited Kai."
        }
      ],
      "players": [
        "p"
      ],
      "worlds": [
        {
          "id": "ann",
          "name": "Ann's Island"
        }
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Hello, Kai."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": [
          "DUPLICATE_ID"
        ],
        "includes": [
          {
            "code": "DUPLICATE_ID",
