        "description": "The bundle's Kai."
      },
      {
        "id": "ann",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "kai"
          },
          {
            "character": "ann"
          }
        ]
      }
    ]
  },
  "session": {
