{
  "description": "A cast member marked player (Format 6.1, 12.2): a predefined bundle character played by a person fills its own seat",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "hero",
        "name": "Hero",
        "description": "The story's hero."
      },
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {
            "character": "hero",
            "player": true
          },
          {
            "character": "a"
          }
        ],
        "variables": [
          {
            "id": "trust",
            "type": "number",
            "of": "characters",
            "initial": 0.5,
            "description": "d"
          }
        ],
        "entries": [
          {
            "id": "e",
            "text": "{{user}} meets {{char}}."
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "players": [
        "hero"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "speaker": "hero",
            "text": "Hi."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "state",
      "expect": {
        "scene.present": [
          "hero",
          "a"
        ],
        "trust.a": 0.5
      }
    },
    {
      "type": "cel",
      "expr": "players == ['hero'] && !has(state.trust.hero)",
      "at": "1",
      "expect": true
    },
    {
      "type": "check",
      "expect": {
        "codes": []
      }
    }
  ]
}
