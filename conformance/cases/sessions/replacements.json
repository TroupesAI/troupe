{
  "description": "Session characters replace bundle characters by ID (Format 12.2): the replacement takes the bundle character's cast position and every reference to it for the whole session; it isn't a DUPLICATE_ID, fills no seat and doesn't join the cast as a newcomer; its own variables, entries and events replace the original's; players listing it means a person took that cast member over",
  "bundle": {
    "troupe": "0.11",
    "kind": "bundle",
    "characters": [
      {
        "id": "kai",
        "name": "Kai",
        "description": "Kai, a thief.",
        "variables": [
          {
            "id": "nerve",
            "type": "int",
            "initial": 1,
            "description": "d"
          },
          {
            "id": "old_only",
            "type": "int",
            "initial": 7,
            "description": "d"
          }
        ],
        "entries": [
          {
            "id": "k_old",
            "text": "{{char}} is the old Kai."
          }
        ],
        "events": [
          {
            "id": "k_old_ev",
            "when": "true",
            "set": {
              "own.old_only": 0
            }
          }
        ]
      },
      {
        "id": "elena",
        "name": "Elena",
        "description": "Elena, a mapmaker.",
        "entries": [
          {
            "id": "e_kai",
            "text": "Elena distrusts {{@kai}}."
          }
        ]
      },
      {
        "id": "ghost",
        "name": "Ghost",
        "description": "Not in the cast."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "elena"
          },
          {
            "character": "kai"
          }
        ],
        "variables": [
          {
            "id": "trust",
            "type": "number",
            "of": "characters",
            "initial": 0.5,
            "min": 0,
            "max": 1,
            "description": "Trust in {{user}}."
          }
        ],
        "openings": [
          {
            "id": "o",
            "content": [
              {
                "speaker": "elena",
                "text": "Evening."
              }
            ]
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "troupe": "0.11",
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        },
        {
          "id": "kai",
          "name": "Kai Mercer",
          "description": "Recast Kai.",
          "variables": [
            {
              "id": "nerve",
              "type": "int",
              "initial": 3,
              "description": "How steady {{char}} is."
            },
            {
              "id": "grit",
              "type": "int",
              "initial": 2,
              "description": "New in the recast."
            }
          ],
          "entries": [
            {
              "id": "k_new",
              "text": "{{char}} is the new Kai."
            }
          ]
        },
        {
          "id": "ghost",
          "name": "Edited Ghost",
          "description": "An edited copy of a character outside the cast."
        }
      ],
      "players": [
        "p"
      ],
      "head": "1"
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Hello, Kai."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "state",
      "name": "cast order unchanged; Kai's state is the replacement's; the ghost replacement doesn't join",
      "expect": {
        "scene.present": [
          "p",
          "elena",
          "kai"
        ],
        "kai.nerve": 3,
        "kai.grit": 2,
        "trust.elena": 0.5,
        "trust.kai": 0.5
      },
      "absent": [
        "kai.old_only",
        "trust.ghost",
        "trust.p"
      ]
    },
    {
      "type": "events",
      "name": "the original's events are gone with it",
      "at": "1",
      "expect": {
        "changes": [],
        "message": null
      }
    },
    {
      "type": "select",
      "name": "the replacement's entries, and references to kai name the replacement",
      "for": "kai",
      "parent": "1",
      "messageId": "2",
      "expect": {
        "activated": [
          "elena/e_kai",
          "kai/k_new"
        ],
        "texts": {
          "kai/k_new": "Kai Mercer is the new Kai.",
          "elena/e_kai": "Elena distrusts Kai Mercer."
        }
      }
    },
    {
      "type": "prompt",
      "name": "the People slot carries the replacement's description in Kai's cast position",
      "for": "elena",
      "parent": "1",
      "messageId": "2",
      "expect": {
        "people": [
          "character:elena",
          "character:kai",
          "player:p"
        ],
        "texts": {
          "character:kai": "Recast Kai."
        }
      }
    },
    {
      "type": "macro",
      "text": "{{@kai}} and {{state.kai.nerve}}",
      "at": "1",
      "expect": "Kai Mercer and 3"
    },
    {
      "type": "check",
      "name": "a replacement isn't a DUPLICATE_ID",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "start",
      "name": "listed in players, the replacement is a person taking that cast member over; the brought character fills the seat",
      "scenario": "s",
      "opening": "o",
      "characters": [
        {
          "id": "kai",
          "name": "Kai Mercer",
          "description": "Recast Kai.",
          "variables": [
            {
              "id": "nerve",
              "type": "int",
              "initial": 3,
              "description": "How steady {{char}} is."
            },
            {
              "id": "grit",
              "type": "int",
              "initial": 2,
              "description": "New in the recast."
            }
          ],
          "entries": [
            {
              "id": "k_new",
              "text": "{{char}} is the new Kai."
            }
          ]
        },
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "kai",
        "p"
      ],
      "expect": {
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.present": [
                "p",
                "elena",
                "kai"
              ]
            }
          }
        ],
        "characters": [
          "kai",
          "p"
        ],
        "header": {
          "players": [
            "kai",
            "p"
          ]
        },
        "state": {
          "kai.nerve": 3
        }
      }
    },
    {
      "type": "start",
      "name": "not listed in players, the replacement stays model-played and absent unless it speaks",
      "scenario": "s",
      "opening": "o",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        },
        {
          "id": "kai",
          "name": "Kai Mercer",
          "description": "Recast Kai.",
          "variables": [
            {
              "id": "nerve",
              "type": "int",
              "initial": 3,
              "description": "How steady {{char}} is."
            },
            {
              "id": "grit",
              "type": "int",
              "initial": 2,
              "description": "New in the recast."
            }
          ],
          "entries": [
            {
              "id": "k_new",
              "text": "{{char}} is the new Kai."
            }
          ]
        }
      ],
      "expect": {
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.present": [
                "p",
                "elena"
              ]
            }
          }
        ],
        "header": {
          "players": [
            "p"
          ]
        }
      }
    }
  ]
}
