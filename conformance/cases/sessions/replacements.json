{
  "description": "Session characters replace bundle characters by ID (Format 12.2): the replacement takes the bundle character's cast position and every reference to it for the whole session; it isn't a DUPLICATE_ID and fills no seat; its own variables replace the original's. A replacement of a character outside the cast counts as a new header character, here a joiner",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "kai",
        "name": "Kai",
        "description": "Kai, a thief.",
        "variables": [
          {
            "id": "nerve",
            "type": "int",
            "initial": 1,
            "description": "d"
          },
          {
            "id": "old_only",
            "type": "int",
            "initial": 7,
            "description": "d"
          }
        ]
      },
      {
        "id": "elena",
        "name": "Elena",
        "description": "Elena, a mapmaker."
      },
      {
        "id": "ghost",
        "name": "Ghost",
        "description": "Not in the cast."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "elena"
          },
          {
            "character": "kai"
          }
        ],
        "variables": [
          {
            "id": "trust",
            "type": "number",
            "of": "characters",
            "initial": 0.5,
            "min": 0,
            "max": 1,
            "description": "Trust in {{user}}."
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        },
        {
          "id": "kai",
          "name": "Kai Mercer",
          "description": "Recast Kai.",
          "variables": [
            {
              "id": "nerve",
              "type": "int",
              "initial": 3,
              "description": "How steady {{char}} is."
            },
            {
              "id": "grit",
              "type": "int",
              "initial": 2,
              "description": "New in the recast."
            }
          ]
        },
        {
          "id": "ghost",
          "name": "Edited Ghost",
          "description": "An edited copy of a character outside the cast."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Hello, Kai."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "state",
      "name": "cast order unchanged; Kai's state is the replacement's; the ghost replacement joins, absent",
      "expect": {
        "scene.present": [
          "p",
          "elena",
          "kai"
        ],
        "kai.nerve": 3,
        "kai.grit": 2,
        "trust.elena": 0.5,
        "trust.kai": 0.5,
        "trust.ghost": 0.5
      },
      "absent": [
        "kai.old_only",
        "trust.p"
      ]
    },
    {
      "type": "macro",
      "text": "{{@kai}} and {{state.kai.nerve}}",
      "at": "1",
      "expect": "Kai Mercer and 3"
    },
    {
      "type": "check",
      "name": "a replacement isn't a DUPLICATE_ID",
      "expect": {
        "codes": []
      }
    }
  ]
}
