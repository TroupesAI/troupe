{
  "description": "Recorded calls (Play 3.4; Format 17.2): a change with args is a call; an invalid one is INVALID_CALL, its values still apply, and it isn't counted; call directions never enter later prompts, while the event pass's do",
  "bundle": {
    "troupe": "0.11",
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          }
        ],
        "variables": [
          {
            "id": "fate",
            "type": "int",
            "description": "d"
          },
          {
            "id": "mood",
            "type": "enum",
            "values": [
              "none",
              "calm",
              "tense"
            ],
            "initial": "none",
            "description": "d"
          },
          {
            "id": "rested",
            "type": "bool",
            "description": "d"
          }
        ],
        "events": [
          {
            "id": "pick_lock",
            "when": "scene.location == 'vault'",
            "call": {
              "by": [
                "model",
                "player"
              ],
              "label": "Pick the lock",
              "description": "Call when someone tries a lock.",
              "params": [
                {
                  "id": "difficulty",
                  "type": "int",
                  "min": 5,
                  "max": 25,
                  "initial": 12,
                  "description": "How hard the lock is."
                }
              ]
            },
            "compute": {
              "fate": "roll(20)"
            },
            "message": [
              {
                "text": "Click (difficulty {{args.difficulty}})."
              }
            ],
            "direct": "Rolled {{state.fate}} against {{args.difficulty}}.",
            "outcomes": [
              {
                "weight": 3,
                "set": {
                  "mood": "calm"
                },
                "direct": "Calm."
              },
              {
                "weight": 1,
                "set": {
                  "mood": "tense"
                }
              }
            ]
          },
          {
            "id": "rest",
            "when": "true",
            "once": true,
            "call": {
              "by": [
                "player"
              ],
              "label": "Rest"
            },
            "set": {
              "rested": true
            },
            "direct": "They rest."
          },
          {
            "id": "closed",
            "when": "false",
            "call": {
              "by": [
                "model"
              ]
            }
          },
          {
            "id": "echo",
            "on": "player",
            "when": "true",
            "message": [
              {
                "text": "Echo."
              }
            ],
            "direct": "Echo heard."
          }
        ],
        "worlds": [
          "w"
        ]
      }
    ],
    "worlds": [
      {
        "id": "w",
        "name": "Town",
        "locations": [
          {
            "id": "vault",
            "name": "The Vault"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "troupe": "0.11",
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "text": "In."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.location": "vault"
            }
          }
        ]
      },
      {
        "id": "m1",
        "parent": "1",
        "from": "model",
        "char": "a",
        "content": [
          {
            "text": "Let me try."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "event": "pick_lock",
            "outcome": 1,
            "args": {
              "difficulty": 10
            },
            "set": {
              "fate": 11,
              "mood": "tense"
            }
          }
        ]
      },
      {
        "id": "m2",
        "parent": "m1",
        "from": "player",
        "content": [
          {
            "text": "My turn."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "event": "rest",
            "args": {},
            "set": {
              "rested": true
            }
          },
          {
            "by": "rules",
            "event": "pick_lock",
            "args": {
              "difficulty": "hard"
            },
            "set": {
              "fate": 20
            }
          },
          {
            "by": "rules",
            "event": "echo",
            "args": {},
            "set": {}
          },
          {
            "by": "rules",
            "event": "echo",
            "set": {}
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": [
          "INVALID_CALL"
        ],
        "includes": [
          {
            "code": "INVALID_CALL",
            "at": "message:m2/changes/1"
          },
          {
            "code": "INVALID_CALL",
            "at": "message:m2/changes/2"
          }
        ]
      }
    },
    {
      "type": "state",
      "name": "an invalid call's values still apply",
      "at": "m2",
      "expect": {
        "fate": 20,
        "rested": true,
        "mood": "tense"
      }
    },
    {
      "type": "cel",
      "name": "only valid calls count",
      "at": "m2",
      "expr": "count('pick_lock') == 1 && count('rest') == 1 && count('echo') == 1",
      "expect": true
    },
    {
      "type": "directions",
      "at": "m2",
      "expect": [
        "Echo heard."
      ]
    },
    {
      "type": "prompt",
      "for": "a",
      "parent": "m2",
      "messageId": "m3",
      "expect": {
        "system": [
          "app",
          "direction"
        ],
        "directions": [
          "Echo heard."
        ]
      }
    }
  ]
}
