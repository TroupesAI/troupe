{
  "description": "Regex keys (Play 5.3): RE2, case-insensitive unless cleared, match anywhere",
  "tests": [
    {
      "type": "match",
      "key": "/dragons?/",
      "text": "Two DRAGONS circle.",
      "expect": true
    },
    {
      "type": "match",
      "key": "/drag/",
      "text": "Dragonfly",
      "expect": true
    },
    {
      "type": "match",
      "key": "/(?-i)Kai/",
      "text": "kai waves",
      "expect": false
    },
    {
      "type": "match",
      "key": "/(?-i)Kai/",
      "text": "Kai waves",
      "expect": true
    },
    {
      "type": "match",
      "name": "RE2 \\b counts _ as a word character",
      "key": "/\\bcat\\b/",
      "text": "cat_toy",
      "expect": false
    },
    {
      "type": "match",
      "name": "dot does not match newline by default",
      "key": "/a.c/",
      "text": "a\nc",
      "expect": false
    },
    {
      "type": "match",
      "name": "lookbehind is not RE2: never matches",
      "key": "/(?<=a)b/",
      "text": "ab",
      "expect": false
    },
    {
      "type": "match",
      "name": "invalid pattern never matches",
      "key": "/[/",
      "text": "[",
      "expect": false
    },
    {
      "type": "match",
      "name": "the text is NFC-normalized; the pattern is compiled unchanged",
      "key": "/café/",
      "text": "café",
      "expect": true
    },
    {
      "type": "match",
      "name": "a lone slash is a plain key",
      "key": "/",
      "text": "a / b",
      "expect": true
    },
    {
      "type": "match",
      "name": "counted repetitions multiplying past 1000 make the regex invalid, so it matches nothing (Format 16 item 5)",
      "key": "/(a{10}){200}/",
      "text": "aaaa",
      "expect": false
    },
    {
      "type": "match",
      "name": "\\C isn't allowed",
      "key": "/a\\C/",
      "text": "ab",
      "expect": false
    },
    {
      "type": "match",
      "name": "a valid counted repetition matches",
      "key": "/(?:ab){2}/",
      "text": "xababx",
      "expect": true
    }
  ]
}
