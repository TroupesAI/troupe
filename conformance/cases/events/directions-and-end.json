{
  "description": "Directions apply while no model message follows the trigger; end finishes the path (Format 9; Play 3.3 step 6)",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          }
        ],
        "variables": [
          {
            "id": "stakes",
            "type": "int",
            "initial": 2,
            "description": "d"
          }
        ],
        "events": [
          {
            "id": "d1",
            "when": "turn == 2",
            "direct": "Raise the stakes to {{state.stakes}}.",
            "message": [
              {
                "text": "A bell rings."
              }
            ]
          },
          {
            "id": "d2",
            "when": "turn == 2",
            "direct": "After a model message.",
            "outcomes": [
              {
                "direct": "Outcome direction.",
                "end": true
              }
            ],
            "on": "model"
          },
          {
            "id": "later",
            "when": "turn == 3",
            "set": {
              "stakes": 5
            }
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ],
      "head": "5"
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "text": "Start."
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "player",
        "content": [
          {
            "text": "Go."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "event": "d1",
            "set": {}
          }
        ]
      },
      {
        "id": "3",
        "parent": "2",
        "from": "system",
        "content": [
          {
            "text": "A bell rings."
          }
        ]
      },
      {
        "id": "4",
        "parent": "3",
        "from": "model",
        "char": "a",
        "content": [
          {
            "text": "Reply."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "event": "d2",
            "outcome": 0,
            "set": {}
          }
        ]
      },
      {
        "id": "5",
        "parent": "4",
        "from": "player",
        "content": [
          {
            "text": "Next."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "directions",
      "name": "next reply after the trigger",
      "at": "3",
      "expect": [
        "Raise the stakes to {{state.stakes}}."
      ]
    },
    {
      "type": "directions",
      "name": "a model message on the path ends it; a model trigger directs the next reply",
      "at": "5",
      "expect": [
        "After a model message.",
        "Outcome direction."
      ]
    },
    {
      "type": "prompt",
      "name": "directions in the system region, macros resolved",
      "for": "a",
      "parent": "3",
      "messageId": "x",
      "expect": {
        "system": [
          "app",
          "direction"
        ],
        "directions": [
          "Raise the stakes to 2."
        ]
      }
    },
    {
      "type": "ended",
      "at": "3",
      "expect": false
    },
    {
      "type": "ended",
      "name": "an outcome's end finishes the path",
      "at": "4",
      "expect": true
    },
    {
      "type": "events",
      "at": "2",
      "eventMessageId": "3",
      "expect": {
        "changes": [
          {
            "by": "rules",
            "event": "d1",
            "set": {}
          }
        ],
        "message": {
          "id": "3",
          "parent": "2",
          "from": "system",
          "content": [
            {
              "text": "A bell rings."
            }
          ]
        },
        "directions": [
          "Raise the stakes to {{state.stakes}}."
        ],
        "ended": false
      }
    },
    {
      "type": "events",
      "name": "after end, events still run if play goes on (Format 9)",
      "at": "5",
      "eventMessageId": "6",
      "expect": {
        "changes": [
          {
            "by": "rules",
            "event": "later",
            "set": {
              "stakes": 5
            }
          }
        ],
        "message": null
      }
    }
  ]
}
