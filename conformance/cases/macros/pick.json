{
  "description": "{{pick}} is fixed for the session: roll('pick', seed, '', options + '#' + index among the picks in that field, from 0) (Format 10; Play 4)",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s"
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "head": "1"
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "text": "x"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "macro",
      "name": "#0 -> blue, #1 -> red",
      "text": "{{pick::red::green::blue}} and {{pick::red::green::blue}}",
      "expect": "blue and red"
    },
    {
      "type": "macro",
      "name": "escaped picks are not picks; a comment ends at the first }}, so the pick inside it is not a pick",
      "text": "\\{{pick::x::y}} {{// {{pick::a::b}} }}{{pick::red::green::blue}}",
      "expect": "{{pick::x::y}}  }}blue"
    },
    {
      "type": "macro",
      "name": "{{user}} with no players stays",
      "text": "{{user}}",
      "expect": "{{user}}"
    }
  ]
}
