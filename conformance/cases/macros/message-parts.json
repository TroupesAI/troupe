{
  "description": "Macros in message parts (Format 10): {{char}} is the part's speaker, else the message's char, else it is left as written; {{user}} follows the path to the message; own means state; parts resolve against the state at their message",
  "note": "Players' and models' text is stored escaped (Format 10), so message 4 holds macros only to test what a part's {{char}} means.",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      },
      {
        "id": "b",
        "name": "Bea",
        "description": "Bea."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {},
          {
            "character": "a"
          },
          {
            "character": "b"
          }
        ],
        "variables": [
          {
            "id": "bell",
            "type": "int",
            "initial": 6,
            "description": "The last bell."
          }
        ],
        "events": [
          {
            "id": "greet",
            "when": "true",
            "message": [
              {
                "speaker": "b",
                "text": "Hello, {{user}}. I'm {{char}}."
              },
              {
                "text": "{{char}} nods at bell {{state.bell}}."
              }
            ]
          }
        ],
        "openings": [
          {
            "id": "o",
            "set": {
              "bell": 7
            },
            "content": [
              {
                "text": "{{char}} waits. Bell {{own.bell}}."
              },
              {
                "speaker": "a",
                "text": "I'm {{char}}, and you are {{user}}."
              }
            ]
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        },
        {
          "id": "q",
          "name": "Quin",
          "description": "Quin."
        }
      ],
      "players": [
        "p",
        "q"
      ]
    },
    "messages": [
      {
        "id": "1",
        "opening": "o",
        "from": "system",
        "content": [
          {
            "text": "{{char}} waits. Bell {{own.bell}}."
          },
          {
            "speaker": "a",
            "text": "I'm {{char}}, and you are {{user}}."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "bell": 7,
              "scene.present": [
                "p",
                "q",
                "a",
                "b"
              ]
            }
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "player",
        "content": [
          {
            "speaker": "q",
            "text": "Hi."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "bell": 8
            }
          },
          {
            "by": "rules",
            "event": "greet",
            "set": {}
          }
        ]
      },
      {
        "id": "3",
        "parent": "2",
        "from": "system",
        "content": [
          {
            "speaker": "b",
            "text": "Hello, {{user}}. I'm {{char}}."
          },
          {
            "text": "{{char}} nods at bell {{state.bell}}."
          }
        ]
      },
      {
        "id": "4",
        "parent": "3",
        "from": "model",
        "char": "a",
        "content": [
          {
            "text": "{{char}} shrugs at {{user}}."
          },
          {
            "speaker": "b",
            "text": "{{char}} again."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "macro",
      "name": "an opening's narration on a system message: {{char}} is left as written; own means state, at the root",
      "part": {
        "message": "1",
        "index": 0
      },
      "expect": "{{char}} waits. Bell 7."
    },
    {
      "type": "macro",
      "name": "a part's speaker; {{user}} before any player message is the first player",
      "part": {
        "message": "1",
        "index": 1
      },
      "expect": "I'm Ann, and you are Pat."
    },
    {
      "type": "macro",
      "name": "an event message: the speaker; {{user}} from the latest player message on the path",
      "part": {
        "message": "3",
        "index": 0
      },
      "expect": "Hello, Quin. I'm Bea."
    },
    {
      "type": "macro",
      "name": "an event message's narration: no speaker and no char, so {{char}} is left as written; the state at the message",
      "part": {
        "message": "3",
        "index": 1
      },
      "expect": "{{char}} nods at bell 8."
    },
    {
      "type": "macro",
      "name": "a model message's narration: the message's char",
      "part": {
        "message": "4",
        "index": 0
      },
      "expect": "Ann shrugs at Quin."
    },
    {
      "type": "macro",
      "name": "the speaker wins over the message's char",
      "part": {
        "message": "4",
        "index": 1
      },
      "expect": "Bea again."
    }
  ]
}
