{
  "description": "The narrator's name (Format 6, 10): {{char}} for the narrator renders as the scenario's narrator, so a story in any language names it naturally",
  "bundle": {
    "kind": "bundle",
    "language": "es",
    "characters": [
      {
        "id": "a",
        "name": "Ana",
        "description": "Ana."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "narrator": "el narrador",
        "entries": [
          {
            "id": "gen",
            "text": "{{char}} describe la escena."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "macro",
      "name": "a narrator generation",
      "text": "{{char}} describe la escena.",
      "narrator": true,
      "expect": "el narrador describe la escena."
    },
    {
      "type": "select",
      "name": "in an entry's text",
      "messageId": "1",
      "expect": {
        "texts": {
          "s/gen": "el narrador describe la escena."
        }
      }
    }
  ]
}
