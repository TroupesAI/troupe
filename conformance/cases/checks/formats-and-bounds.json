{
  "description": "Validators assert format, so a malformed timestamp is SCHEMA (Format 17.2); an unknown message field is UNKNOWN_FIELD; named bounds must name non-keyed numeric variables of the same owner (Format 8.1); a timestamp with an offset instead of Z is SCHEMA (Format 2.5)",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          }
        ],
        "variables": [
          {
            "id": "rep",
            "type": "int",
            "of": [
              "watch"
            ],
            "description": "d"
          },
          {
            "id": "name",
            "type": "string",
            "description": "d"
          },
          {
            "id": "x",
            "type": "int",
            "max": "rep",
            "description": "a keyed bound"
          },
          {
            "id": "y",
            "type": "int",
            "min": "name",
            "description": "a string bound"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "at": "yesterday",
        "content": [
          {
            "text": "x"
          }
        ],
        "mood": "odd"
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": [
          "SCHEMA",
          "UNKNOWN_FIELD",
          "UNKNOWN_VARIABLE"
        ],
        "includes": [
          {
            "code": "SCHEMA",
            "at": "message:1/at"
          },
          {
            "code": "UNKNOWN_FIELD",
            "at": "message:1/mood"
          },
          {
            "code": "UNKNOWN_VARIABLE",
            "at": "/scenarios/0/variables/2/max"
          },
          {
            "code": "UNKNOWN_VARIABLE",
            "at": "/scenarios/0/variables/3/min"
          }
        ]
      }
    },
    {
      "type": "parse",
      "name": "a timestamp in UTC",
      "kind": "session",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"session\",\"scenario\":\"s\",\"seed\":\"k7Qm2xVb9TzR4pLc8NwYfA\"}\n{\"id\":\"1\",\"from\":\"player\",\"at\":\"2026-10-11T09:00:00Z\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "ok": true,
        "codes": [],
        "ids": [
          "1"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a timestamp with an offset",
      "kind": "session",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"session\",\"scenario\":\"s\",\"seed\":\"k7Qm2xVb9TzR4pLc8NwYfA\"}\n{\"id\":\"1\",\"from\":\"player\",\"at\":\"2026-10-11T12:00:00+03:00\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "ok": false,
        "codes": [
          "SCHEMA"
        ]
      }
    }
  ]
}
