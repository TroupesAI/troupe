{
  "description": "Validators assert format, so a malformed timestamp is SCHEMA (Format 15.3); a timestamp has an uppercase T, and an uppercase Z or a numeric offset (Format 2.5); an unknown message field is UNKNOWN_FIELD; min and max are integers, so one naming a variable is SCHEMA (Format 8)",
  "bundle": {
    "kind": "bundle",
    "scenarios": [
      {
        "id": "s",
        "variables": [
          {
            "id": "rep",
            "type": "int",
            "of": [
              "watch"
            ],
            "description": "d"
          },
          {
            "id": "name",
            "type": "string",
            "description": "d"
          },
          {
            "id": "x",
            "type": "int",
            "max": "rep",
            "description": "a bound naming a variable"
          },
          {
            "id": "y",
            "type": "int",
            "min": "name",
            "description": "a bound naming a variable"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "at": "yesterday",
        "content": [
          {
            "text": "x"
          }
        ],
        "mood": "odd"
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": [
          "SCHEMA",
          "UNKNOWN_FIELD"
        ],
        "includes": [
          {
            "code": "SCHEMA",
            "at": "message:1/at"
          },
          {
            "code": "UNKNOWN_FIELD",
            "at": "message:1/mood"
          },
          {
            "code": "SCHEMA",
            "at": "/scenarios/0/variables/2/max"
          },
          {
            "code": "SCHEMA",
            "at": "/scenarios/0/variables/3/min"
          }
        ]
      }
    },
    {
      "type": "parse",
      "name": "a timestamp in UTC",
      "kind": "session",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"session\",\"scenario\":\"s\"}\n{\"id\":\"1\",\"from\":\"player\",\"at\":\"2026-10-11T09:00:00Z\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a timestamp with an offset",
      "kind": "session",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"session\",\"scenario\":\"s\"}\n{\"id\":\"1\",\"from\":\"player\",\"at\":\"2026-10-11T12:00:00.250+03:00\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a lowercase z",
      "kind": "session",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"session\",\"scenario\":\"s\"}\n{\"id\":\"1\",\"from\":\"player\",\"at\":\"2026-10-11T09:00:00z\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "codes": [
          "SCHEMA"
        ]
      }
    }
  ]
}
