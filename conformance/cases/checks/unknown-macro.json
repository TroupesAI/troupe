{
  "description": "In text where macros resolve, text between {{ and }} that is no macro, such as {{original}}, and a macro naming an undeclared variable are UNKNOWN_MACRO (Format 9, 15.3); a pick needs at least two options, none empty. Names, taglines and titles are used as written, so they hold no UNKNOWN_MACRO",
  "bundle": {
    "kind": "bundle",
    "tagline": "Into the {{dark}}.",
    "scenarios": [
      {
        "id": "s",
        "name": "The {{dark}}",
        "tagline": "{{nothing}} waits.",
        "entries": [
          {
            "id": "e",
            "text": "{{char}} sees {{state.nothing_here}}."
          },
          {
            "id": "one",
            "text": "Either {{pick::a}}."
          },
          {
            "id": "empty",
            "text": "Or {{pick::a::}}."
          },
          {
            "id": "fine",
            "title": "{{not_a_macro}}",
            "text": "{{pick::a::b}} and {{pick::x::x}}."
          },
          {
            "id": "at",
            "text": "{{original}} waves."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
