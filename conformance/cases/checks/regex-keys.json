{
  "description": "A regex key that isn't valid is REGEX_ERROR (Format 15, 16.3)",
  "bundle": {
    "kind": "bundle",
    "scenarios": [
      {
        "id": "s",
        "entries": [
          {
            "id": "bad",
            "keys": [
              "/[/"
            ],
            "text": "bad"
          },
          {
            "id": "big",
            "keys": [
              "/(a{10}){200}/"
            ],
            "text": "too many repetitions"
          },
          {
            "id": "mixed",
            "keys": [
              "/[/",
              "lamp"
            ],
            "text": "one good key"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": [
          "REGEX_ERROR"
        ],
        "includes": [
          {
            "code": "REGEX_ERROR",
            "at": "/scenarios/0/entries/0/keys/0"
          },
          {
            "code": "REGEX_ERROR",
            "at": "/scenarios/0/entries/1/keys/0"
          },
          {
            "code": "REGEX_ERROR",
            "at": "/scenarios/0/entries/2/keys/0"
          }
        ]
      }
    }
  ]
}
