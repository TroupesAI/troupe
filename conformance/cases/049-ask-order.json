{
  "description": "ask (Format 8.1; Play 2.1): questions are asked when a session starts, in the order scenario, worlds, characters, then declaration order; answers are player changes on the root, whatever by says",
  "bundle": {
    "troupe": "0.11",
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann.",
        "variables": [
          {
            "id": "nick",
            "type": "string",
            "ask": "What does Ann call you?",
            "description": "d"
          }
        ]
      }
    ],
    "worlds": [
      {
        "id": "w",
        "name": "W",
        "variables": [
          {
            "id": "season",
            "type": "enum",
            "values": [
              "spring",
              "winter"
            ],
            "ask": "Which season?",
            "description": "d"
          }
        ]
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          }
        ],
        "variables": [
          {
            "id": "plan",
            "type": "enum",
            "values": [
              "sneak",
              "fight"
            ],
            "ask": "Sneak or fight?",
            "description": "d"
          },
          {
            "id": "name",
            "type": "string",
            "ask": "Your codename?",
            "description": "d"
          }
        ],
        "openings": [
          {
            "id": "o",
            "content": [
              {
                "speaker": "a",
                "text": "Ready?"
              }
            ]
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "start",
      "name": "unanswered questions, in order",
      "scenario": "s",
      "opening": "o",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "expect": {
        "questions": [
          "plan",
          "name",
          "w.season",
          "a.nick"
        ]
      }
    },
    {
      "type": "start",
      "name": "answers become one player change after the opening's change",
      "scenario": "s",
      "opening": "o",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "answers": {
        "plan": "fight",
        "w.season": "winter",
        "a.nick": "boss"
      },
      "expect": {
        "questions": [
          "name"
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.present": [
                "p",
                "a"
              ]
            }
          },
          {
            "by": "player",
            "set": {
              "plan": "fight",
              "w.season": "winter",
              "a.nick": "boss"
            }
          }
        ],
        "state": {
          "plan": "fight",
          "a.nick": "boss"
        }
      }
    },
    {
      "type": "start",
      "name": "without an opening, the player's first message is the root and carries the answers",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "answers": {
        "name": "Fox"
      },
      "firstMessage": {
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Hi."
          }
        ]
      },
      "expect": {
        "changes": [
          {
            "by": "player",
            "set": {
              "name": "Fox"
            }
          }
        ],
        "head": "1"
      }
    },
    {
      "type": "check",
