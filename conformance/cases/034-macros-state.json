{
  "description": "State macros (Format 10): labels, numbers as ECMAScript toString, booleans, lists, maps, char/user path segments, {{@state.x}}, the state at a message",
  "bundle": {
    "troupe": "0.11",
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      },
      {
        "id": "b",
        "name": "Bea",
        "description": "Bea."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "variables": [
          {
            "id": "approach",
            "type": "enum",
            "values": [
              "quiet",
              "loud"
            ],
            "labels": {
              "quiet": "Slip in unseen"
            },
            "initial": "quiet",
            "description": "d"
          },
          {
            "id": "bell",
            "type": "int",
            "initial": 7,
            "description": "d"
          },
          {
            "id": "ratio",
            "type": "number",
            "initial": 0.25,
            "description": "d"
          },
          {
            "id": "tiny",
            "type": "number",
            "initial": 1e-07,
            "description": "d"
          },
          {
            "id": "ok",
            "type": "bool",
            "initial": true,
            "description": "d"
          },
          {
            "id": "inv",
            "type": "set",
            "values": [
              "rope",
              "torch"
            ],
            "labels": {
              "rope": "a coil of rope"
            },
            "initial": [
              "rope",
              "torch"
            ],
            "description": "d"
          },
          {
            "id": "trust",
            "type": "number",
            "of": "characters",
            "initial": {
              "*": 0.5,
              "a": 0.7
            },
            "description": "d"
          },
          {
            "id": "leader",
            "type": "string",
            "initial": "b",
            "description": "a character ID"
          },
          {
            "id": "crew",
            "type": "set",
            "initial": [
              "b",
              "a"
            ],
            "description": "character IDs"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "troupe": "0.11",
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ],
      "head": "2"
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "text": "x"
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "player",
        "content": [
          {
            "text": "y"
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "bell": 8,
              "approach": "loud"
            }
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "macro",
      "at": "1",
      "text": "{{state.approach}} at {{state.bell}}",
      "expect": "Slip in unseen at 7"
    },
    {
      "type": "macro",
      "name": "against the state at that message; unlabeled values render raw",
      "at": "2",
      "text": "{{state.approach}} at {{state.bell}}",
      "expect": "loud at 8"
    },
    {
      "type": "macro",
      "text": "{{state.ratio}} {{state.tiny}} {{state.ok}}",
      "expect": "0.25 1e-7 true"
    },
    {
      "type": "macro",
      "text": "{{state.inv}}",
      "expect": "a coil of rope, torch"
    },
    {
      "type": "macro",
      "text": "{{state.trust.char}} {{state.trust.user}} {{state.trust.b}}",
      "char": "a",
      "expect": "0.7  0.5",
      "name": "user has no trust (of characters excludes players): an absent key renders as nothing"
    },
    {
      "type": "macro",
      "name": "a whole map renders as Name: value pairs; an absent key renders as nothing; an undeclared variable is left as written",
      "text": "{{state.trust}} {{state.trust.zed}} {{state.nope}} {{state.trust.char}}",
      "expect": "Ann: 0.7, Bea: 0.5  {{state.nope}} "
    },
    {
      "type": "macro",
      "text": "{{@state.leader}} leads.",
      "expect": "Bea leads."
    },
    {
      "type": "macro",
      "name": "{{@state}} of a set of character IDs",
      "text": "{{@state.crew}}",
      "expect": "Bea, Ann"
    },
    {
      "type": "macro",
      "text": "{{@state.approach}}",
      "expect": "quiet",
      "name": "{{@state}} of a value that names no character or location renders the value",
      "note": "Spec gap (Format 10): {{@state.x}} is defined for values holding character or location IDs; for other values this reading renders the value itself."
    }
  ]
}
