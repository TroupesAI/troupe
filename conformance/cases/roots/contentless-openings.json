{
  "description": "Openings without content (Format 6.3, 12.1, 12.4): the root is a records-only system message with the opening's change, valid, and conditions there see its opening",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "ann",
        "name": "Ann",
        "description": "An innkeeper."
      },
      {
        "id": "bea",
        "name": "Bea",
        "description": "A bard."
      }
    ],
    "worlds": [
      {
        "id": "w",
        "name": "W",
        "locations": [
          {
            "id": "tavern",
            "name": "The Tavern"
          }
        ]
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "ann"
          },
          {
            "character": "bea"
          }
        ],
        "variables": [
          {
            "id": "mood",
            "type": "string",
            "initial": "calm",
            "description": "The room's mood."
          }
        ],
        "entries": [
          {
            "id": "first_tavern",
            "position": "system",
            "when": "opening == 'tavern' && turn == 0",
            "text": "Open at {{@scene.location}}: {{@ann}} greets {{user}}."
          }
        ],
        "events": [
          {
            "id": "arrive",
            "when": "turn == 0 && opening == 'tavern'",
            "set": {
              "mood": "festive"
            },
            "message": [
              {
                "speaker": "ann",
                "text": "Welcome, {{user}}!"
              }
            ]
          },
          {
            "id": "after_player",
            "on": "player",
            "when": "true",
            "set": {
              "mood": "chatty"
            }
          }
        ],
        "openings": [
          {
            "id": "tavern",
            "title": "At the tavern",
            "set": {
              "scene.location": "tavern"
            }
          },
          {
            "id": "road",
            "title": "On the road",
            "set": {
              "scene.present": [
                "bea"
              ]
            }
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "opening": "tavern",
        "from": "system",
        "content": [],
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.location": "tavern",
              "scene.present": [
                "p",
                "ann",
                "bea"
              ]
            }
          },
          {
            "by": "rules",
            "event": "arrive",
            "set": {
              "mood": "festive"
            }
          }
        ]
      },
      {
        "id": "1-events",
        "parent": "1",
        "from": "system",
        "content": [
          {
            "speaker": "ann",
            "text": "Welcome, {{user}}!"
          }
        ]
      },
      {
        "id": "2",
        "parent": "1-events",
        "from": "model",
        "char": "ann",
        "content": [
          {
            "speaker": "ann",
            "text": "Sit anywhere."
          }
        ]
      },
      {
        "id": "3",
        "parent": "2",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Thanks."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "event": "after_player",
            "set": {
              "mood": "chatty"
            }
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "cel",
      "name": "opening is the root's opening, also at the event message",
      "expr": "opening == 'tavern' && turn == 0",
      "at": "1-events",
      "expect": true
    },
    {
      "type": "check",
      "expect": {
        "codes": []
      }
    }
  ]
}
