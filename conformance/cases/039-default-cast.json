{
  "description": "A scenario without cast or worlds (Format 6.1, 6.3): the default cast is one player seat and every bundle character in bundle order, and every bundle world is in use; the opening's speakers start present, and an opening without content starts with the whole cast",
  "bundle": {
    "troupe": "0.11",
    "kind": "bundle",
    "characters": [
      {
        "id": "elena",
        "name": "Elena Voss",
        "description": "A meticulous thief.",
        "entries": [
          {
            "id": "maps",
            "keys": [
              "map"
            ],
            "text": "{{char}} guards her maps."
          }
        ],
        "variables": [
          {
            "id": "patience",
            "type": "int",
            "initial": 3,
            "min": 0,
            "max": 5,
            "by": [
              "model"
            ],
            "description": "How patient {{char}} is with {{user}}."
          }
        ],
        "events": [
          {
            "id": "snap",
            "when": "own.patience == 0",
            "once": true,
            "direct": "Elena loses her temper."
          }
        ]
      },
      {
        "id": "kai",
        "name": "Kai",
        "description": "In the default cast, but silent in the opening."
      }
    ],
    "worlds": [
      {
        "id": "w1",
        "name": "One",
        "entries": [
          {
            "id": "a",
            "text": "World one."
          }
        ]
      },
      {
        "id": "w2",
        "name": "Two",
        "entries": [
          {
            "id": "b",
            "text": "World two."
          }
        ]
      }
    ],
    "scenarios": [
      {
        "id": "workshop",
        "openings": [
          {
            "id": "late",
            "set": {
              "elena.patience": 2
            },
            "content": [
              {
                "speaker": "elena",
                "text": "You're late. Sit down, and don't touch the maps."
              }
            ]
          },
          {
            "id": "anytime",
            "title": "Drop by"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "troupe": "0.11",
      "kind": "session",
      "scenario": "workshop",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "you",
          "name": "Robin",
          "description": "A client."
        }
      ],
      "players": [
        "you"
      ],
      "head": "2"
    },
    "messages": [
      {
        "id": "1",
        "from": "system",
        "content": [
          {
            "speaker": "elena",
            "text": "You're late. Sit down, and don't touch the maps."
          }
        ],
        "opening": "late",
        "changes": [
          {
            "by": "rules",
            "set": {
              "elena.patience": 2,
              "scene.present": [
                "you",
                "elena"
              ]
            }
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "player",
        "content": [
          {
            "speaker": "you",
            "text": "Sorry. Can I see the map?"
          }
        ],
        "changes": [
          {
            "by": "player",
            "set": {
              "elena.patience": 1
            }
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "state",
      "name": "the default cast: the seat, then Elena and Kai; Kai doesn't speak in the opening, so he starts absent",
      "at": "1",
      "expect": {
        "scene.present": [
          "you",
          "elena"
        ],
        "elena.patience": 2
      }
    },
    {
      "type": "state",
      "at": "2",
      "expect": {
        "scene.present": [
          "you",
          "elena"
        ],
        "elena.patience": 1
      },
      "name": "readers apply recorded changes without re-checking by"
    },
    {
      "type": "select",
      "for": "elena",
      "parent": "2",
      "messageId": "3",
      "expect": {
        "activated": [
          "w1/a",
          "w2/b",
          "elena/maps"
        ],
        "texts": {
          "elena/maps": "Elena Voss guards her maps."
        }
      }
    },
    {
      "type": "check",
      "name": "the player's change to patience is not allowed by `by`, but readers don't re-check by",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "start",
      "scenario": "workshop",
      "opening": "late",
      "characters": [
        {
          "id": "you",
          "name": "Robin",
          "description": "A client."
        }
      ],
      "expect": {
        "changes": [
          {
            "by": "rules",
            "set": {
              "elena.patience": 2,
              "scene.present": [
                "you",
                "elena"
              ]
            }
          }
        ],
        "state": {
          "elena.patience": 2,
          "scene.present": [
            "you",
            "elena"
          ]
        }
      }
    },
    {
      "type": "start",
      "name": "an opening without content starts with the whole cast present, players included",
      "scenario": "workshop",
      "opening": "anytime",
      "characters": [
        {
          "id": "you",
          "name": "Robin",
          "description": "A client."
        }
      ],
      "expect": {
        "root": {
          "id": "1",
          "opening": "anytime",
          "from": "system",
          "content": [],
          "changes": [
            {
              "by": "rules",
              "set": {
                "scene.present": [
                  "you",
                  "elena",
                  "kai"
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
