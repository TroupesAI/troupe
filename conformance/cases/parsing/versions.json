{
  "description": "Versions (Format 15, 17.2), read by a 0.12 reader: before 1.0, another minor version is an UNSUPPORTED_VERSION warning, and the reader may still read it; another major version is refused with UNSUPPORTED_VERSION",
  "tests": [
    {
      "type": "parse",
      "name": "a newer minor",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an older minor",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.11\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "0.9 is another minor, not 0.90",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.9\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "another major",
      "kind": "bundle",
      "text": "{\"troupe\":\"1.0\",\"kind\":\"bundle\"}",
      "expect": {
        "ok": false,
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "another major with the same minor",
      "kind": "bundle",
      "text": "{\"troupe\":\"1.12\",\"kind\":\"bundle\"}",
      "expect": {
        "ok": false,
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a session of another minor",
      "kind": "session",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"session\",\"scenario\":\"s\",\"seed\":\"k7Qm2xVb9TzR4pLc8NwYfA\"}\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a chronicle of another major",
      "kind": "chronicle",
      "text": "{\"troupe\":\"1.0\",\"kind\":\"chronicle\",\"id\":\"c1\",\"character\":{\"id\":\"mira\",\"name\":\"Mira\",\"description\":\"d\"}}\n",
      "expect": {
        "ok": false,
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    }
  ]
}
