{
  "description": "Versions (Format 13, 15.3), against this 0.13 document: a file of any other version, minor or major, is UNSUPPORTED_VERSION",
  "tests": [
    {
      "type": "parse",
      "name": "a newer minor",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.14\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an older minor",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "0.9 is another minor, not 0.90",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.9\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "another major",
      "kind": "bundle",
      "text": "{\"troupe\":\"1.0\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "another major with the same minor",
      "kind": "bundle",
      "text": "{\"troupe\":\"1.13\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a session of another minor",
      "kind": "session",
      "text": "{\"troupe\":\"0.14\",\"kind\":\"session\",\"scenario\":\"s\"}\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    }
  ]
}
