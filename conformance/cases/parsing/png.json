{
  "description": "The image-embedded form (Format 14.4): one iTXt chunk with keyword troupe, compressed, holds the bundle, read exactly like a .troupe.json file; readers prefer it to a ccv3 chunk; a PNG with no troupe chunk or with two is PARSE",
  "tests": [
    {
      "type": "parse",
      "name": "a PNG with a troupe chunk",
      "kind": "png",
      "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAAcmlUWHR0cm91cGUAAQAAAHicJcsxCoAwDEbhq8g/F9G1mwfwBOIQ22CDGktaJ/HuIo6Pj3ej2nllhkfX9j0cNtEIj+XSuDMcQiKjUNkK/HRDPjzECA5KxzeOf0UuwSRXORUeQ1MqWUmSG9ZVlNlaPPPzAu2dJO5h7VOeAAAACklEQVR4nGNgAAAAAgABSK+kcQAAAABJRU5ErkJggg==",
      "expect": {
        "ok": true,
        "codes": [],
        "equals": {
          "troupe": "0.11",
          "kind": "bundle",
          "characters": [
            {
              "id": "mira",
              "name": "Mira",
              "description": "A starship engineer."
            }
          ]
        }
      }
    },
    {
      "type": "parse",
      "name": "the troupe chunk is preferred to a ccv3 chunk",
      "kind": "png",
      "base64": "",
