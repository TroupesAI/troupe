{
  "description": "The image-embedded form (Format 14.4): one iTXt chunk with keyword troupe, compressed, holds the bundle, read exactly like a .troupe.json file; readers ignore other chunks, such as ccv3; a PNG with no troupe chunk or with two is PARSE",
  "tests": [
    {
      "type": "parse",
      "name": "a PNG with a troupe chunk",
      "kind": "png",
      "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAAcmlUWHR0cm91cGUAAQAAAHicJcsxCoAwDEbhq8g/F1HHbh7AE4hDbIMGNZa0TuLdRRwfH+9GsfNKDI+mbjs4bKIRHvOlcWc4hJWMQmHL8OMN+fAQIzgoHd84/BU5B5NU5FR49FUuZHmVVLEuosxW45meF+4AJO+TYh/iAAAACklEQVR4nGNgAAAAAgABSK+kcQAAAABJRU5ErkJggg==",
      "expect": {
        "ok": true,
        "codes": [],
        "equals": {
          "troupe": "0.12",
          "kind": "bundle",
          "characters": [
            {
              "id": "mira",
              "name": "Mira",
              "description": "A starship engineer."
            }
          ]
        }
      }
    },
    {
      "type": "parse",
      "name": "a ccv3 chunk beside the troupe chunk is ignored",
      "kind": "png",
      "base64": "",
      "expect": {
        "ok": true,
        "codes": [],
        "equals": {
          "troupe": "0.12",
          "kind": "bundle",
          "characters": [
            {
              "id": "mira",
              "name": "Mira",
              "description": "A starship engineer."
            }
          ]
        }
      }
    },
    {
      "type": "parse",
      "name": "two troupe chunks",
      "kind": "png",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "only a ccv3 chunk",
      "kind": "png",
      "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAAYXRFWHRjY3YzAGV5SnpjR1ZqSWpvaVkyaGhjbUZmWTJGeVpGOTJNeUlzSW5Od1pXTmZkbVZ5YzJsdmJpSTZJak11TUNJc0ltUmhkR0VpT25zaWJtRnRaU0k2SWsxcGNtRWlmWDA91QvdsQAAAApJREFUeJxjYAAAAAIAAUivpHEAAAAASUVORK5CYII=",
      "expect": {
        "ok": false,
