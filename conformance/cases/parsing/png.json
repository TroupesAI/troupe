    {
      "type": "parse",
      "name": "not a PNG",
      "kind": "png",
      "base64": "iVBOWA0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAAcmlUWHR0cm91cGUAAQAAAHicJcsxCoAwDEbhq8g/F9G1mwfwBOIQ22CDGktaJ/HuIo6Pj3ej2nllhkfX9j0cNtEIj+XSuDMcQiKjUNkK/HRDPjzECA5KxzeOf0UuwSRXORUeQ1MqWUmSG9ZVlNlaPPPzAu2dJO5h7VOeAAAACklEQVR4nGNgAAAAAgABSK+kcQAAAABJRU5ErkJggg==",
      "expect": {
        "ok": false,
