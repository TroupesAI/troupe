{
  "description": "Package contents (Format 14.3, 17.2): an exact duplicate name is PARSE; an unreadable line in a session inside a valid package is PARSE; compression methods other than store and deflate, and a referenced file with a path segment over 255 bytes, are PARSE; sessions belong to the package only in their folder",
  "tests": [
    {
      "type": "parse",
      "name": "two entries with the same name",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unreadable session line inside a valid package",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a compression method other than store or deflate",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a referenced file with a path segment over 255 bytes",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a session outside sessions/ isn't part of the package",
      "note": "The stray file isn't valid JSON, so it would be PARSE if it were part of the package.",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    }
  ]
}
