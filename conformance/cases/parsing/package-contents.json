{
  "description": "Package contents and paths (Format 12.2, 12.3, 15.3): package paths appear only in a package, a data: URI's media type is lowercase, and every path a package's bundle or sessions reference is a file of the package, or it is PARSE; an exact duplicate name, compression methods other than store and deflate, and an unreadable line in a session inside a valid package, for a session reader (Format 15.2), are PARSE; a file with a path segment over 255 bytes isn't part of the package; sessions belong to the package only in their folder",
  "tests": [
    {
      "type": "parse",
      "name": "two entries with the same name",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unreadable session line inside a valid package",
      "level": "session",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a compression method other than store or deflate",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a referenced file with a path segment over 255 bytes",
      "note": "The 256-byte name is outside the path grammar, so the file isn't part of the package, and the cover names no file of it.",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a session outside sessions/ isn't part of the package",
      "note": "The stray files aren't valid JSON, so they would be PARSE if they were part of the package.",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a referenced file the package holds",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a referenced file the package lacks",
      "kind": "package",
      "base64": "UEsDBBQAAAAIAAAAS11zvED+NgAAADsAAAALAAAAYnVuZGxlLmpzb26rViopyi8tSFWyUjLQMzRW0lHKzsxLAfKSSvNSclKB/OT8stQioEBuakpmoj6Yp1eQl65UCwBQSwECFAMUAAAACAAAAEtdc7xA/jYAAAA7AAAACwAAAAAAAAAAAAAAgIEAAAAAYnVuZGxlLmpzb25QSwUGAAAAAAEAAQA5AAAAXwAAAAAA",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a file a session references, which the package lacks",
      "level": "session",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a file a session references, in the package",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a package path in a single file",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"bundle\",\"cover\":\"cover.webp\"}",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an https URL in a single file",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"bundle\",\"cover\":\"https://example.com/cover.webp\"}",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a data: URI in a single file",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"bundle\",\"cover\":\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYGBgAAAABQABpfZFQAAAAABJRU5ErkJggg==\"}",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a data: URI with an uppercase media type",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"bundle\",\"cover\":\"data:image/PNG;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYGBgAAAABQABpfZFQAAAAABJRU5ErkJggg==\"}",
      "expect": {
        "codes": [
          "SCHEMA"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a package path in a session file",
      "kind": "session",
      "text": "{\"troupe\":\"0.13\",\"kind\":\"session\",\"scenario\":\"s\"}\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"type\":\"image\",\"src\":\"map.png\"}]}\n",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    }
  ]
}
