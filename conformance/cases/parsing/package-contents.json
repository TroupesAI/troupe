{
  "description": "Package contents (Format 14.3, 16 item 7, 17.2): an exact duplicate name is PARSE and the package isn't read; chronicles under chronicles/ are read with the bundle; an unreadable line in a session inside a valid package is PARSE; compression methods other than store and deflate and segments over 255 bytes are PARSE; sessions and chronicles are read only from their folders (Format 14.3, 16)",
  "tests": [
    {
      "type": "parse",
      "name": "two entries with the same name",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a chronicle under chronicles/",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": true,
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a chronicle under chronicles/ is read: one without a character fails the schema",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "SCHEMA"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unreadable session line inside a valid package",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a compression method other than store or deflate",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a path segment over 255 bytes",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a session outside sessions/ isn't read",
      "note": "The stray file isn't valid JSON, so reading it would report PARSE.",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": true,
        "codes": []
      }
    }
  ]
}
