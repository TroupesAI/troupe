{
  "description": "Raw input (Format 2.2, 12, 14, 16.2): a leading byte order mark and an empty session line aren't I-JSON lines, so they are PARSE; a troupe value that isn't major.minor fails the schema; a session of another major version is UNSUPPORTED_VERSION",
  "tests": [
    {
      "type": "parse",
      "name": "a bundle with a byte order mark",
      "kind": "bundle",
      "text": "﻿{\"troupe\":\"0.12\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a session with a byte order mark",
      "kind": "session",
      "text": "﻿{\"troupe\":\"0.12\",\"kind\":\"session\",\"scenario\":\"s\"}\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an empty line is PARSE",
      "kind": "session",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"session\",\"scenario\":\"s\"}\n\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"text\":\"Hi.\"}]}\n\n{\"id\":\"2\",\"parent\":\"1\",\"from\":\"model\",\"content\":[{\"text\":\"Hello.\"}]}\n\n",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "troupe with three parts",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.12.0\",\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "SCHEMA"
        ]
      }
    },
    {
      "type": "parse",
      "name": "troupe as a number",
      "kind": "bundle",
      "text": "{\"troupe\":0.12,\"kind\":\"bundle\"}",
      "expect": {
        "codes": [
          "SCHEMA"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a session of another major version",
      "kind": "session",
      "text": "{\"troupe\":\"1.0\",\"kind\":\"session\",\"scenario\":\"s\"}\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    }
  ]
}
