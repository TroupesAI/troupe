      }
    },
    {
      "type": "parse",
      "name": "only a zTXt chunk with keyword troupe",
      "kind": "png",
      "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAAb3pUWHR0cm91cGUAAHicJcsxCoAwDEbhq8g/F9G1mwfwBOIQ22CDGktaJ/HuIo6Pj3ej2nllhkfX9j0cNtEIj+XSuDMcQiKjUNkK/HRDPjzECA5KxzeOf0UuwSRXORUeQ1MqWUmSG9ZVlNlaPPPzAu2dJO75CqAjAAAACklEQVR4nGNgAAAAAgABSK+kcQAAAABJRU5ErkJggg==",
