        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a tEXt chunk beside the iTXt chunk is ignored, not a second troupe chunk",
      "kind": "png",
      "base64": "",
      "expect": {
        "ok": true,
        "codes": [],
        "equals": {
          "troupe": "0.11",
          "kind": "bundle",
          "characters": [
            {
              "id": "mira",
              "name": "Mira",
              "description": "A starship engineer."
            }
          ]
        }
      }
    },
    {
