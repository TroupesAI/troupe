{
  "description": "Reading sessions and chronicles (Format 12, 12.1, 13, 17.2): session lines end with LF or CRLF and the last newline is optional; an unreadable line other than the header is PARSE and skipped; an unreadable header means the file isn't read; a chronicle is one JSON document. ids lists the message IDs read",
  "tests": [
    {
      "type": "parse",
      "name": "a session",
      "kind": "session",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"session\",\"scenario\":\"s\",\"seed\":\"k7Qm2xVb9TzR4pLc8NwYfA\"}\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"text\":\"Hi.\"}]}\n{\"id\":\"2\",\"parent\":\"1\",\"from\":\"model\",\"content\":[{\"text\":\"Hello.\"}]}\n",
      "expect": {
        "ok": true,
        "codes": [],
        "ids": [
          "1",
          "2"
        ]
      }
    },
    {
      "type": "parse",
      "name": "CRLF and no final newline",
      "kind": "session",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"session\",\"scenario\":\"s\",\"seed\":\"k7Qm2xVb9TzR4pLc8NwYfA\"}\r\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"text\":\"Hi.\"}]}\r\n{\"id\":\"2\",\"parent\":\"1\",\"from\":\"model\",\"content\":[{\"text\":\"Hello.\"}]}",
      "expect": {
        "ok": true,
        "codes": [],
        "ids": [
          "1",
          "2"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unreadable line is skipped",
      "kind": "session",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"session\",\"scenario\":\"s\",\"seed\":\"k7Qm2xVb9TzR4pLc8NwYfA\"}\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"text\":\"Hi.\"}]}\n{\"id\":\n{\"id\":\"2\",\"parent\":\"1\",\"from\":\"model\",\"content\":[{\"text\":\"Hello.\"}]}\n",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ],
        "ids": [
          "1",
          "2"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unreadable header",
      "kind": "session",
      "text": "{\"troupe\":\"0.12\",\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"text\":\"Hi.\"}]}\n",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an empty file",
      "kind": "session",
      "text": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a bundle where a session is expected",
      "kind": "session",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"bundle\"}\n",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a chronicle",
      "kind": "chronicle",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"chronicle\",\"id\":\"c1\",\"character\":{\"id\":\"mira\",\"name\":\"Mira\",\"description\":\"d\"},\"memories\":[{\"id\":\"met\",\"text\":\"Mira met Mara.\"}],\"values\":{}}\n",
      "expect": {
        "ok": true,
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a chronicle followed by another JSON value isn't read",
      "kind": "chronicle",
      "text": "{\"troupe\":\"0.12\",\"kind\":\"chronicle\",\"id\":\"c1\",\"character\":{\"id\":\"mira\",\"name\":\"Mira\",\"description\":\"d\"}}\n{\"id\":\"r1\"}\n",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    }
  ]
}
