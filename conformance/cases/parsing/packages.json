{
  "description": "Packages (Format 14.3, 16 item 7): bundle.json at the root, sessions under sessions/; absolute paths, .. segments, backslashes, paths outside the grammar, names equal when compared case-insensitively, encryption and symbolic links are PARSE, and the package isn't read",
  "tests": [
    {
      "type": "parse",
      "name": "a package",
      "kind": "package",
      "base64": "UEsDBBQAAAAIAAAAS13PW/r4IwAAACEAAAALAAAAYnVuZGxlLmpzb26rViopyi8tSFWyUjLQMzRU0lHKzsxLUbJSSirNS8lJVaoFAFBLAQIUAxQAAAAIAAAAS13PW/r4IwAAACEAAAALAAAAAAAAAAAAAACAAQAAAABidW5kbGUuanNvblBLBQYAAAAAAQABADkAAABMAAAAAAA=",
      "expect": {
        "ok": true,
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a package with a session",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": true,
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "no bundle.json",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a .. segment",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an absolute path",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a backslash",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a segment outside the path grammar",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "names that differ only in case",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an encrypted entry",
      "kind": "package",
      "base64": "UEsDBBQAAQAIAAAAS13PW/r4IwAAACEAAAALAAAAYnVuZGxlLmpzb26rViopyi8tSFWyUjLQMzRU0lHKzsxLUbJSSirNS8lJVaoFAFBLAQIUAxQAAQAIAAAAS13PW/r4IwAAACEAAAALAAAAAAAAAAAAAACAAQAAAABidW5kbGUuanNvblBLBQYAAAAAAQABADkAAABMAAAAAAA=",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a symbolic link",
      "kind": "package",
      "base64": "",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "not a ZIP archive",
      "kind": "package",
      "base64": "UEsDBCBub3QgcmVhbGx5",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    }
  ]
