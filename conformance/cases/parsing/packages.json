{
  "description": "Packages (Format 13.3): bundle.json at the root, sessions under sessions/; absolute paths, .. segments, backslashes, names equal when compared case-insensitively, encryption and symbolic links are PARSE; a directory entry (a name ending in /) and an unreferenced file outside the path grammar aren't part of the package",
  "tests": [
    {
      "type": "parse",
      "name": "a package",
      "kind": "package",
      "base64": "UEsDBBQAAAAIAAAAS11m3axbIQAAACEAAAALAAAAYnVuZGxlLmpzb26rViopyi8tSFWyUjLQMzRS0lHKzsxLAfKSSvNSclKVagFQSwECFAMUAAAACAAAAEtdZt2sWyEAAAAhAAAACwAAAAAAAAAAAAAAgAEAAAAAYnVuZGxlLmpzb25QSwUGAAAAAAEAAQA5AAAASgAAAAAA",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a package with a session",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a directory entry isn't part of the package",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "no bundle.json",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a .. segment",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an absolute path",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a backslash",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unreferenced entry outside the path grammar isn't part of the package",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "names that differ only in case",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an encrypted entry",
      "kind": "package",
      "base64": "UEsDBBQAAQAIAAAAS11m3axbIQAAACEAAAALAAAAYnVuZGxlLmpzb26rViopyi8tSFWyUjLQMzRS0lHKzsxLAfKSSvNSclKVagFQSwECFAMUAAEACAAAAEtdZt2sWyEAAAAhAAAACwAAAAAAAAAAAAAAgAEAAAAAYnVuZGxlLmpzb25QSwUGAAAAAAEAAQA5AAAASgAAAAAA",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a symbolic link",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "not a ZIP archive",
      "kind": "package",
      "base64": "UEsDBCBub3QgcmVhbGx5",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    }
  ]
}
