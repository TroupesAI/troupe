{
  "description": "Packages (Format 12.3, 15.2): bundle.json at the root, sessions under sessions/, which a bundle reader may leave unread; absolute paths, .. segments, backslashes, names equal when compared case-insensitively, encryption and symbolic links are PARSE; a directory entry (a name ending in /) and an unreferenced file outside the path grammar aren't part of the package",
  "tests": [
    {
      "type": "parse",
      "name": "a package",
      "kind": "package",
      "base64": "UEsDBBQAAAAIAAAAS10+XU6MIQAAACEAAAALAAAAYnVuZGxlLmpzb26rViopyi8tSFWyUjLQMzRW0lHKzsxLAfKSSvNSclKVagFQSwECFAMUAAAACAAAAEtdPl1OjCEAAAAhAAAACwAAAAAAAAAAAAAAgIEAAAAAYnVuZGxlLmpzb25QSwUGAAAAAAEAAQA5AAAASgAAAAAA",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a package with a session",
      "note": "A bundle reader accepts it too, and may leave the session unread (Format 15.2).",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a directory entry isn't part of the package",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "no bundle.json",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a .. segment",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an absolute path",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a backslash",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unreferenced entry outside the path grammar isn't part of the package",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "names that differ only in case",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an encrypted entry",
      "kind": "package",
      "base64": "UEsDBBQAAQAIAAAAS10+XU6MIQAAACEAAAALAAAAYnVuZGxlLmpzb26rViopyi8tSFWyUjLQMzRW0lHKzsxLAfKSSvNSclKVagFQSwECFAMUAAEACAAAAEtdPl1OjCEAAAAhAAAACwAAAAAAAAAAAAAAgIEAAAAAYnVuZGxlLmpzb25QSwUGAAAAAAEAAQA5AAAASgAAAAAA",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a symbolic link",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "not a ZIP archive",
      "kind": "package",
      "base64": "UEsDBCBub3QgcmVhbGx5",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    }
  ]
}
