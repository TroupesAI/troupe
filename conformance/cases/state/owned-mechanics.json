{
  "description": "Owned mechanics (Format 2.3, 6.4, 8.2): each variable and event keeps its owner, so a character, a world and a scenario can each declare a variable and an event with the same ID",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann.",
        "variables": [
          {
            "id": "time",
            "type": "int",
            "initial": 9,
            "description": "Ann's own time"
          }
        ],
        "events": [
          {
            "id": "tick",
            "when": "true",
            "compute": {
              "a.time": "own.time + 1"
            }
          }
        ]
      }
    ],
    "worlds": [
      {
        "id": "w",
        "name": "W",
        "variables": [
          {
            "id": "time",
            "type": "int",
            "initial": 1,
            "description": "the world's clock"
          }
        ],
        "events": [
          {
            "id": "tick",
            "when": "true",
            "compute": {
              "w.time": "own.time + 10"
            }
          }
        ]
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          }
        ],
        "variables": [
          {
            "id": "time",
            "type": "int",
            "initial": 100,
            "description": "the scenario's own time"
          }
        ],
        "events": [
          {
            "id": "tick",
            "when": "true",
            "compute": {
              "time": "state.time + state.w.time"
            }
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "x"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "state",
      "expect": {
        "time": 100,
        "w.time": 1,
        "a.time": 9
      }
    },
    {
      "type": "cel",
      "expr": "count('w/tick') == 0 && ago('a.time') == 1000000000",
      "at": "1",
      "expect": true
    },
    {
      "type": "check",
      "expect": {
        "codes": []
      },
      "name": "two owners can share a variable ID"
    }
  ]
}
