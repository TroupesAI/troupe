{
  "description": "Change preparation (Play 3.3): invalid keys dropped first, then maxStep for the model, oneWay for numbers, bools and enums, clamp, rounding as toFixed(6)",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          }
        ],
        "variables": [
          {
            "id": "hp",
            "type": "int",
            "min": 0,
            "max": 10,
            "initial": 5,
            "by": [
              "model"
            ],
            "maxStep": 3,
            "description": "d"
          },
          {
            "id": "clock",
            "type": "int",
            "max": 12,
            "initial": 4,
            "oneWay": true,
            "by": [
              "model",
              "player"
            ],
            "description": "d"
          },
          {
            "id": "mood",
            "type": "number",
            "min": 0,
            "max": 1,
            "initial": 0.5,
            "by": [
              "model"
            ],
            "maxStep": 0.2,
            "description": "d"
          },
          {
            "id": "flag",
            "type": "bool",
            "initial": true,
            "oneWay": true,
            "by": [
              "model"
            ],
            "description": "d"
          },
          {
            "id": "drift",
            "type": "number",
            "min": -1,
            "max": 1,
            "description": "d"
          },
          {
            "id": "phase",
            "type": "enum",
            "values": [
              "setup",
              "heist",
              "escape"
            ],
            "initial": "heist",
            "oneWay": true,
            "description": "only moves later in values"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "prepare",
      "name": "maxStep up",
      "by": "model",
      "set": {
        "hp": 9
      },
      "expect": {
        "set": {
          "hp": 8
        }
      }
    },
    {
      "type": "prepare",
      "name": "maxStep down",
      "by": "model",
      "set": {
        "hp": 0
      },
      "expect": {
        "set": {
          "hp": 2
        }
      }
    },
    {
      "type": "prepare",
      "name": "rules: no maxStep, clamped",
      "by": "rules",
      "set": {
        "hp": 15
      },
      "expect": {
        "set": {
          "hp": 10
        }
      }
    },
    {
      "type": "prepare",
      "name": "rules: clamped to min",
      "by": "rules",
      "set": {
        "hp": -3
      },
      "expect": {
        "set": {
          "hp": 0
        }
      }
    },
    {
      "type": "prepare",
      "name": "oneWay keeps the current value",
      "by": "player",
      "set": {
        "clock": 2
      },
      "expect": {
        "set": {
          "clock": 4
        }
      }
    },
    {
      "type": "prepare",
      "name": "oneWay also binds events",
      "by": "rules",
      "set": {
        "clock": 1
      },
      "expect": {
        "set": {
          "clock": 4
        }
      }
    },
    {
      "type": "prepare",
      "name": "clamp after oneWay",
      "by": "model",
      "set": {
        "clock": 20
      },
      "expect": {
        "set": {
          "clock": 12
        }
      }
    },
    {
      "type": "prepare",
      "name": "number maxStep",
      "by": "model",
      "set": {
        "mood": 0.95
      },
      "expect": {
        "set": {
          "mood": 0.7
        }
      }
    },
    {
      "type": "prepare",
      "name": "round to 6 places",
      "by": "rules",
      "set": {
        "mood": 0.1234567
      },
      "expect": {
        "set": {
          "mood": 0.123457
        }
      }
    },
    {
      "type": "prepare",
      "name": "a positive tie rounds up",
      "by": "rules",
      "set": {
        "mood": 0.0078125
      },
      "expect": {
        "set": {
          "mood": 0.007813
        }
      }
    },
    {
      "type": "prepare",
      "name": "bools only turn true",
      "by": "model",
      "set": {
        "flag": false
      },
      "expect": {
        "set": {
          "flag": true
        }
      }
    },
    {
      "type": "prepare",
      "name": "an int is never rounded: 6.5 is invalid and dropped",
      "by": "model",
      "set": {
        "hp": 6.5
      },
      "expect": {
        "set": {},
        "dropped": [
          "hp"
        ]
      }
    },
    {
      "type": "prepare",
      "name": "validity is checked before preparation: 9.5 is dropped though maxStep would make it 8",
      "by": "model",
      "set": {
        "hp": 9.5
      },
      "expect": {
        "set": {},
        "dropped": [
          "hp"
        ]
      }
    },
    {
      "type": "prepare",
      "name": "wrong type dropped",
      "by": "model",
      "set": {
        "hp": "7",
        "mood": true
      },
      "expect": {
        "set": {},
        "dropped": [
          "hp",
          "mood"
        ]
      }
    },
    {
      "type": "prepare",
      "name": "a negative tie: toFixed(6) gives -0.007813",
      "by": "rules",
      "set": {
        "drift": -0.0078125
      },
      "expect": {
        "set": {
          "drift": -0.007813
        }
      }
    },
    {
      "type": "prepare",
      "name": "oneWay enum: a move back keeps the current value",
      "by": "rules",
      "set": {
        "phase": "setup"
      },
      "expect": {
        "set": {
          "phase": "heist"
        }
      }
    },
    {
      "type": "prepare",
      "name": "oneWay enum: a move forward is kept",
      "by": "rules",
      "set": {
        "phase": "escape"
      },
      "expect": {
        "set": {
          "phase": "escape"
        }
      }
    }
  ]
}
