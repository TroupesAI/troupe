{
  "description": "A derived variable whose expression fails at runtime is absent: has() is false and its macro renders as nothing (Format 8.1, 10)",
  "bundle": {
    "kind": "bundle",
    "scenarios": [
      {
        "id": "s",
        "variables": [
          {
            "id": "zero",
            "type": "int",
            "description": "d"
          },
          {
            "id": "ratio",
            "type": "int",
            "derive": "100 / state.zero",
            "description": "fails at runtime"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s"
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "text": "x"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "state",
      "name": "ratio divides by zero, so it is absent",
      "at": "1",
      "expect": {
        "zero": 0
      },
      "absent": [
        "ratio"
      ]
    },
    {
      "type": "cel",
      "at": "1",
      "expr": "!has(state.ratio)",
      "expect": true
    },
    {
      "type": "macro",
      "at": "1",
      "text": "[{{state.ratio}}]",
      "expect": "[]"
    },
    {
      "type": "check",
      "expect": {
        "codes": []
      }
    }
  ]
}
