{
  "description": "Named bounds in the state (Format 8.1, 8.6): the bound is the named variable's current value; a bound the same change sets applies with its new value, even when its key comes later; an initial value is clamped by the named variable's initial value; a stored value isn't clamped again when its bound changes later",
  "bundle": {
    "kind": "bundle",
    "scenarios": [
      {
        "id": "s",
        "variables": [
          {
            "id": "max_hp",
            "type": "int",
            "min": 1,
            "initial": 30,
            "description": "d"
          },
          {
            "id": "hp",
            "type": "int",
            "min": 0,
            "max": "max_hp",
            "initial": 50,
            "description": "d"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Level up."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "hp": 35,
              "max_hp": 40
            }
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Curse."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "max_hp": 20
            }
          }
        ]
      },
      {
        "id": "3",
        "parent": "2",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Heal."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "hp": 33
            }
          }
        ]
      },
      {
        "id": "2b",
        "parent": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Two steps."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "max_hp": 32
            }
          },
          {
            "by": "rules",
            "set": {
              "hp": 38
            }
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "state",
      "name": "initial 50 is clamped to max_hp's initial 30",
      "expect": {
        "hp": 30,
        "max_hp": 30
      }
    },
    {
      "type": "state",
      "name": "max_hp set by the same change bounds hp, though its key sorts after hp",
      "at": "1",
      "expect": {
        "hp": 35,
        "max_hp": 40
      }
    },
    {
      "type": "state",
      "name": "lowering max_hp doesn't clamp the stored hp again",
      "at": "2",
      "expect": {
        "hp": 35,
        "max_hp": 20
      }
    },
    {
      "type": "state",
      "name": "a later change to hp is clamped by max_hp's current value",
      "at": "3",
      "expect": {
        "hp": 20,
        "max_hp": 20
      }
    },
    {
      "type": "state",
      "name": "a bound set by an earlier change of the same message is the current value",
      "at": "2b",
      "expect": {
        "hp": 32,
        "max_hp": 32
      }
    }
  ]
}
