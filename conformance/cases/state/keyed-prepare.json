  "tests": [
    {
      "type": "prepare",
      "name": "maxStep limits each key on its own",
      "by": "model",
      "set": {
        "trust.a": 0.9,
        "trust.b": 0.4
      },
      "expect": {
        "set": {
          "trust.a": 0.7,
          "trust.b": 0.4
        }
      }
    },
    {
      "type": "prepare",
      "name": "oneWay keeps each key from moving backward",
      "by": "model",
      "set": {
        "bond.a": 2,
        "bond.b": 5
      },
      "expect": {
        "set": {
          "bond.a": 3,
          "bond.b": 5
        }
      }
    },
    {
      "type": "prepare",
      "name": "oneWay applies to rules too",
      "by": "rules",
      "set": {
        "bond.a": 1
      },
      "expect": {
        "set": {
          "bond.a": 3
        }
      }
    },
    {
      "type": "prepare",
      "name": "a derived variable can't be changed",
      "by": "rules",
      "set": {
        "day": 5,
        "clock": 40
      },
      "expect": {
        "set": {
          "clock": 40
        },
        "dropped": [
          "day"
        ]
      }
    },
    {
      "type": "state",
      "name": "readers clamp, round and normalize recorded values, keep moves maxStep, oneWay and channels would refuse, and drop the derived key",
