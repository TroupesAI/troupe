        "trust.b": 0.912346,
        "bond.a": 1,
        "bond.b": 3,
        "tags.a": [
          "brave",
          "shy"
        ],
        "tags.b": [],
        "day": 2,
        "secret": 4
      }
    },
    {
      "type": "check",
      "expect": {
        "codes": [
          "UNKNOWN_VARIABLE"
        ],
        "includes": [
          {
            "code": "UNKNOWN_VARIABLE",
            "at": "/scenarios/0/variables/6/max"
          },
          {
            "code": "UNKNOWN_VARIABLE",
            "at": "/scenarios/0/variables/7/max"
          },
          {
            "code": "UNKNOWN_VARIABLE",
            "at": "message:1/changes/0/set/day"
          }
        ]
