{
  "description": "Derived variables (Format 8.1, 8.6): computed from stored state when read, never recorded",
  "bundle": {
    "kind": "bundle",
    "scenarios": [
      {
        "id": "s",
        "variables": [
          {
            "id": "clock",
            "type": "int",
            "initial": 30,
            "oneWay": true,
            "description": "Hours since the start."
          },
          {
            "id": "day",
            "type": "int",
            "derive": "state.clock / 24 + 1",
            "description": "The day."
          },
          {
            "id": "night",
            "type": "bool",
            "derive": "state.clock % 24 >= 20 || state.clock % 24 < 6",
            "description": "Night time."
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "text": "x"
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "clock": 45
            }
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "state",
      "name": "derived values in the initial state",
      "expect": {
        "clock": 30,
        "day": 2,
        "night": false
      }
    },
    {
      "type": "state",
      "at": "1",
      "expect": {
        "clock": 45,
        "day": 2,
        "night": true
      }
    },
    {
      "type": "cel",
      "at": "1",
      "expr": "state.day == 2 && state.night",
      "expect": true
    },
    {
      "type": "macro",
      "at": "1",
      "text": "Day {{state.day}}.",
      "expect": "Day 2."
    },
    {
      "type": "check",
      "expect": {
        "codes": []
      },
      "name": "derived variables that read stored state are valid"
    }
  ]
}
