{
  "description": "The model output schema (Play 3.4, Format Appendix A: model-output.schema.json): structured replies and tracker results validate; speakers and knownBy are plain strings; unknown properties, including newcomers' mechanics and entries' position and priority, are UNKNOWN_FIELD warnings (Format 15); change keys and values are left to preparation; a part without text is SCHEMA",
  "tests": [
    {
      "type": "parse",
      "name": "a structured reply",
      "kind": "modelOutput",
      "text": "{\"parts\":[{\"speaker\":\"kai\",\"text\":\"Fine.\"},{\"text\":\"*He looks away.*\",\"knownBy\":[\"kai\"]}],\"changes\":{\"kai.nerve\":2}}",
      "expect": {
        "ok": true,
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a tracker result",
      "kind": "modelOutput",
      "text": "{\"changes\":{\"bell\":8},\"entries\":[{\"id\":\"stair\",\"knownBy\":[\"kai\"],\"text\":\"Kai noticed the back stair.\"}],\"characters\":[{\"id\":\"guard\",\"name\":\"A guard\",\"description\":\"A bored night guard.\"}]}",
      "expect": {
        "ok": true,
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "nothing found",
      "kind": "modelOutput",
      "text": "{}",
      "expect": {
        "ok": true,
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a speaker written as a name is valid; applying it drops it",
      "kind": "modelOutput",
      "text": "{\"parts\": [{\"speaker\": \"Kai\", \"text\": \"Fine.\", \"knownBy\": [\"Kai\"]}]}",
      "expect": {
        "ok": true,
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a newcomer's mechanics are unknown fields",
      "kind": "modelOutput",
      "text": "{\"characters\": [{\"id\": \"rook\", \"name\": \"Rook\", \"description\": \"A thief.\", \"events\": [{\"id\": \"boom\", \"when\": \"true\", \"end\": true}]}]}",
      "expect": {
        "ok": true,
        "codes": [
          "UNKNOWN_FIELD"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an entry's position and priority are unknown fields",
      "kind": "modelOutput",
      "text": "{\"entries\": [{\"id\": \"rule\", \"text\": \"Obey.\", \"position\": \"system\", \"priority\": 100}]}",
      "expect": {
        "ok": true,
        "codes": [
          "UNKNOWN_FIELD"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unknown property",
      "kind": "modelOutput",
      "text": "{\"parts\":[{\"text\":\"Hi.\"}],\"mood\":\"tense\"}",
      "expect": {
        "ok": true,
        "codes": [
          "UNKNOWN_FIELD"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a part without text",
      "kind": "modelOutput",
      "text": "{\"parts\":[{\"speaker\":\"kai\"}]}",
      "expect": {
        "ok": false,
        "codes": [
          "SCHEMA"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a malformed change key is left to preparation",
      "kind": "modelOutput",
      "text": "{\"changes\":{\"Bad Key\":1}}",
      "expect": {
        "ok": true,
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "not JSON",
      "kind": "modelOutput",
      "text": "Sure! Here is the JSON:",
      "expect": {
        "ok": false,
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "reason is no longer a field",
      "kind": "modelOutput",
      "text": "{\"changes\":{\"bell\":8},\"reason\":\"An hour passed.\"}",
      "expect": {
        "ok": true,
        "codes": [
          "UNKNOWN_FIELD"
        ]
      }
    }
  ]
}
