{
  "description": "The session's limits (Play 6): they reach every generation in the System slot, right after the app's prompt, for a character and for the narrator in characters mode, and fitting never drops them",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          }
        ],
        "entries": [
          {
            "id": "rule",
            "position": "system",
            "text": "Keep it short."
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ],
      "limits": {
        "lines": [
          "gore"
        ],
        "veils": [
          "romance"
        ]
      }
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Hi."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "prompt",
      "name": "a character's generation",
      "for": "a",
      "parent": "1",
      "messageId": "2",
      "expect": {
        "system": [
          "app",
          "limits",
          "entry:s/rule"
        ]
      }
    },
    {
      "type": "prompt",
      "name": "the narrator in characters mode",
      "parent": "1",
      "messageId": "2",
      "expect": {
        "system": [
          "app",
          "limits",
          "entry:s/rule"
        ]
      }
    },
    {
      "type": "prompt",
      "name": "fitting drops the entry, never the limits",
      "for": "a",
      "parent": "1",
      "messageId": "2",
      "maxEntries": 0,
      "expect": {
        "system": [
          "app",
          "limits"
        ]
      }
    },
    {
      "type": "select",
      "name": "fitting with nothing at priority 100 doesn't fail",
      "for": "a",
      "parent": "1",
      "messageId": "2",
      "maxEntries": 0,
      "expect": {
        "dropped": [
          "s/rule"
        ],
        "failed": false
      }
    }
  ]
}
