{
  "description": "Credits and spoilers (Format 3, 6.1): bundle credits are Markdown for people, never sent to models; a cast member's spoiler is informative for interfaces and changes nothing in the engine",
  "bundle": {
    "troupe": "0.11",
    "kind": "bundle",
    "name": "The Cellar",
    "authors": [
      "Sakura"
    ],
    "credits": "Based on [The Cellar](https://example.com/cellar) by Sakura. CC BY 4.0.",
    "characters": [
      {
        "id": "ann",
        "name": "Ann",
        "description": "A guide."
      },
      {
        "id": "ghost",
        "name": "The Ghost",
        "description": "A ghost in the cellar.",
        "entries": [
          {
            "id": "cold",
            "text": "The air turns cold around {{char}}."
          }
        ]
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "ann"
          },
          {
            "character": "ghost",
            "spoiler": true,
            "notes": "Hidden from the cast list until first present."
          }
        ],
        "openings": [
          {
            "id": "o",
            "set": {
              "scene.present": [
                "ann",
                "ghost"
              ]
            },
            "content": [
              {
                "speaker": "ann",
                "text": "Mind the stairs."
              }
            ]
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "troupe": "0.11",
      "kind": "session",
      "scenario": "s",
      "seed": "conformanceSeed0001",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ],
      "head": "1"
    },
    "messages": [
      {
        "id": "1",
        "opening": "o",
        "from": "system",
        "content": [
          {
            "speaker": "ann",
            "text": "Mind the stairs."
          }
        ],
        "changes": [
          {
            "by": "rules",
            "set": {
              "scene.present": [
                "p",
                "ann",
                "ghost"
              ]
            }
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "name": "credits and spoiler validate",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "state",
      "name": "a spoiler cast member is an ordinary cast member to the engine",
      "at": "1",
      "expect": {
        "scene.present": [
          "p",
          "ann",
          "ghost"
        ]
      }
    },
    {
      "type": "select",
      "for": "ann",
      "parent": "1",
      "messageId": "2",
      "expect": {
        "activated": [
          "ghost/cold"
        ],
        "texts": {
          "ghost/cold": "The air turns cold around The Ghost."
        }
      }
    },
    {
      "type": "prompt",
      "name": "no prompt item carries the credits; the spoiler character is in People",
      "for": "ann",
      "parent": "1",
      "messageId": "2",
      "expect": {
        "system": [
          "app"
        ],
        "setting": [],
        "people": [
          "character:ann",
          "character:ghost",
          "player:p"
        ],
        "context": [
          "entry:ghost/cold"
        ],
        "history": [
          "message:1"
        ],
        "texts": {
          "character:ghost": "A ghost in the cellar."
        }
      }
    }
  ]
}
